# Noesis рядом с существующим nginx/site на VPS.
# Рендерится infra/deploy-no-docker.sh в /etc/nginx/sites-available/noesis.

server {
  listen 80;
  server_name {{NOESIS_SERVER_NAMES}};
  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl;
  server_name {{NOESIS_SERVER_NAMES}};

  ssl_certificate     {{NOESIS_SSL_CERT}};
  ssl_certificate_key {{NOESIS_SSL_KEY}};
  include /etc/letsencrypt/options-ssl-nginx.conf;
  ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

  client_max_body_size 20m;

  # Внутренние server-to-server ручки дёргаются напрямую по backend-порту на
  # самом хосте — снаружи не нужны. Глушим на edge (defense-in-depth).
  location /api/internal/ {
    return 404;
  }

  # Анонимная форма заявки не должна наследовать server-level лимит 20m:
  # backend буферизует JSON целиком в памяти. Загрузки документов сделки
  # покрыты более узким location ниже с лимитом 25m.
  location = /api/leads {
    client_max_body_size 1m;
    proxy_pass http://127.0.0.1:{{NOESIS_BACKEND_PORT}};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location /api/ {
    proxy_pass http://127.0.0.1:{{NOESIS_BACKEND_PORT}};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location ~ ^/api/(constructions|developers|news|files)(/|$) {
    client_max_body_size 320m;
    proxy_pass http://127.0.0.1:{{NOESIS_BACKEND_PORT}};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # Документы сделки (за логином CRM): POST /api/leads/:id/documents. Скан
  # договора/акта перевалит server-level 20m — поднимаем до лимита документа
  # бэкенда (25 МБ). Узкий путь: анонимный POST /api/leads остаётся под 1m.
  location ~ ^/api/leads/[^/]+/documents(/|$) {
    client_max_body_size 25m;
    proxy_pass http://127.0.0.1:{{NOESIS_BACKEND_PORT}};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # Закрывающие документы сделки лежат в `deals/`, но раздавать их напрямую
  # нельзя: CRM скачивает их через auth-gated API-маршрут.
  location ^~ /files/deals/ {
    return 404;
  }

  location /files/ {
    alias {{NOESIS_FILES_DIR}}/;
    try_files $uri =404;
    expires 30d;
    add_header Cache-Control "public, immutable";
    access_log off;
  }

  location /crm/ {
    alias {{NOESIS_DEPLOY_DIR}}/webapp/dist/;
    try_files $uri $uri/ /crm/index.html;
  }

  location /constructions/ {
    root {{NOESIS_DEPLOY_DIR}}/website/web/current;
    try_files $uri $uri/ $uri.html @noesis_stale;
  }

  location /news/ {
    root {{NOESIS_DEPLOY_DIR}}/website/web/current;
    try_files $uri $uri/ $uri.html @noesis_stale;
  }

  location @noesis_stale {
    return 301 /#catalog;
  }

  location / {
    root {{NOESIS_DEPLOY_DIR}}/website/web/current;
    try_files $uri $uri/ $uri.html /index.html;
  }
}
