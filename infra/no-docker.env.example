# Noesis рядом с существующим сайтом на VPS БЕЗ Docker.
# Скопируйте в infra/no-docker.env и заполните секреты:
#   cp infra/no-docker.env.example infra/no-docker.env
#
# Файл читает infra/deploy-no-docker.sh. Значения должны быть shell-friendly:
# без пробелов вокруг "=", секреты лучше генерировать hex/base64 без пробелов.

# --- Где живёт код и от чьего имени работает backend ---
NOESIS_DEPLOY_DIR=/var/www/noesis_adv
NOESIS_RUN_USER=noesis
NOESIS_HOME=/var/lib/noesis
NOESIS_FILES_DIR=/var/lib/noesis/files

# --- Домен и TLS ---
# На текущем VPS уже есть wildcard-сертификат catlg.ru-0001 и nginx-конфиг
# catalog-noema с *.catlg.ru. Точный server_name noesis.catlg.ru будет выбран
# раньше wildcard, поэтому текущий каталог не ломается.
NOESIS_DOMAIN=noesis.catlg.ru
NOESIS_SERVER_NAMES=noesis.catlg.ru
NOESIS_SSL_CERT=/etc/letsencrypt/live/catlg.ru-0001/fullchain.pem
NOESIS_SSL_KEY=/etc/letsencrypt/live/catlg.ru-0001/privkey.pem

# --- Локальный backend ---
# 3000 уже занят catalog.noema, поэтому Noesis слушает 3001 только на localhost.
NOESIS_BACKEND_PORT=3001
NOESIS_BACKEND_HOST=127.0.0.1

# --- PostgreSQL на хосте ---
# База и роль создаются idempotent-скриптом. Пароль нужен и для DATABASE_URL.
POSTGRES_DB=noesis
POSTGRES_USER=noesis
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD

# --- Публичные origins ---
SITE_URL=https://noesis.catlg.ru
PUBLIC_YANDEX_MAPS_API_KEY=
CORS_ORIGINS=https://noesis.catlg.ru
COOKIE_SECURE=true
SESSION_TTL_HOURS=12
CRM_BASE_URL=https://noesis.catlg.ru/crm

# --- Первый администратор ---
# Создаётся сидом при первом деплое, пароль нужно сменить после входа.
ADMIN_EMAIL=admin@noesis-grozny.ru
ADMIN_PASSWORD=CHANGE_ME_TEMP_ADMIN_PASSWORD

# --- Автопубликация лендинга из CRM ---
# Сгенерировать: openssl rand -hex 24
BUILD_WORKER_TOKEN=CHANGE_ME_RANDOM_BUILD_TOKEN
REBUILD_DEBOUNCE_SECONDS=120
REBUILD_STALL_MINUTES=15
BUILD_POLL_SECONDS=30
BUILD_KEEP_RELEASES=5

# --- Напоминания о сроке брони (Telegram-дайджест по cron) ---
# Секрет внутренней ручки POST /api/internal/bookings/reminders/notify.
# Если не задан — Telegram-рассылка выключена (веб-«Мой день» работает всегда).
# Сгенерировать: openssl rand -hex 24
# REMINDER_CRON_TOKEN=CHANGE_ME_RANDOM_REMINDER_TOKEN

# --- Опциональные уведомления/бэкапы ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# BACKUP_TELEGRAM_CHAT_ID=
# BACKUP_PASSPHRASE=
