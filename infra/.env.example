# Прод-окружение для infra/docker-compose.prod.yml (скопируйте в infra/.env)

# --- База данных ---
POSTGRES_DB=noesis
POSTGRES_USER=noesis
POSTGRES_PASSWORD=ЗАМЕНИТЕ_НА_ДЛИННЫЙ_ПАРОЛЬ

# --- Доступ снаружи ---
# Пока домена нет — сайт открыт по голому IP и БЕЗ HTTPS.
# CORS_ORIGINS — точный origin, по которому открывают сайт/CRM (схема + хост,
# без хвостового слэша; порт 80 не указывается). Должен совпадать с тем, что
# видит браузер, иначе мутирующие запросы (вход в CRM, отправка заявки) → 403.
CORS_ORIGINS=http://168.222.140.78
# Когда появится домен и сертификат — поменяйте, например, на:
# CORS_ORIGINS=https://noesis-grozny.ru,https://www.noesis-grozny.ru

# --- Сессии CRM (httpOnly-cookie) ---
SESSION_TTL_HOURS=12
# По HTTP флаг Secure НУЖНО выключить: иначе браузер не сохранит сессионную
# cookie и вход в CRM работать не будет. На HTTPS верните COOKIE_SECURE=true.
COOKIE_SECURE=false

# --- Первый администратор ---
# Создаётся сид-командой при первом развёртывании
# (docker compose ... exec backend bun run --cwd backend db:seed). Пароль сменить после входа.
ADMIN_EMAIL=admin@noesis-grozny.ru
ADMIN_PASSWORD=ЗАМЕНИТЕ_НА_ВРЕМЕННЫЙ_ПАРОЛЬ

# --- Автопересборка лендинга (Веха 4.2) ---
# Секрет для внутренних ручек сборщика (/api/internal/site-build/*). Тот же
# токен читает сервис-сборщик (noesis-site-builder) из этого файла. БЕЗ кавычек.
# Если пусто — автопересборка выключена (правки появляются только ручным деплоем).
# Сгенерировать, например: openssl rand -hex 24
BUILD_WORKER_TOKEN=ЗАМЕНИТЕ_НА_СЛУЧАЙНЫЙ_ТОКЕН
# Дебаунс: сколько секунд тишины после последней правки ждём перед сборкой.
REBUILD_DEBOUNCE_SECONDS=120

# --- Адрес сайта (canonical/OG/sitemap) ---
# Пока по IP. При переходе на домен раскомментируйте и пересоберите (см.
# docs/DEPLOYMENT_VPS.md, «Переход на домен»):
# SITE_URL=https://noesis-grozny.ru
# PUBLIC_YANDEX_MAPS_API_KEY=

# --- Бэкапы (infra/backup.sh, см. docs/backup-restore.md) ---
# Офсайт-копия дампа БД в Telegram: токен бота (можно тот же, что для
# уведомлений о заявках) + id приватного чата/канала для бэкапов + парольная
# фраза шифрования (дамп содержит ПДн, наружу уходит только зашифрованным gpg;
# без BACKUP_PASSPHRASE отправка пропускается). Если пусто — бэкап остаётся
# только локально в /root/noesis-backups.
# Сгенерировать фразу: openssl rand -base64 24. Сохраните её копию вне VPS —
# без неё офсайт-копию не расшифровать.
# TELEGRAM_BOT_TOKEN=
# BACKUP_TELEGRAM_CHAT_ID=
# BACKUP_PASSPHRASE=
