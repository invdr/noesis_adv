---
import { CONSTRUCTION_FORMAT_LABEL, orderHomepageConstructions } from "@noesis/contracts";
import BenefitsSection from "../components/home/BenefitsSection.astro";
import ContactSection from "../components/home/ContactSection.astro";
import HomeHero from "../components/home/HomeHero.astro";
import HomeInventory from "../components/home/HomeInventory.astro";
import MaterialsSection from "../components/home/MaterialsSection.astro";
import NewsSection from "../components/home/NewsSection.astro";
import ProcessSection from "../components/home/ProcessSection.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  fetchConstructions,
  fetchDocumentCategories,
  fetchNews,
  fetchSiteSettings,
  fetchSiteStats,
  toCatalogItem,
  toNewsView,
} from "../lib/api";
import { buildChrome } from "../lib/chrome";
import { absUrl, BRAND_NAME } from "../lib/site";

const [constructions, news, documentCategories, stats, settings] = await Promise.all([
  fetchConstructions(),
  fetchNews(),
  fetchDocumentCategories(),
  fetchSiteStats(),
  fetchSiteSettings(),
]);
const chrome = buildChrome(settings);
const ordered = orderHomepageConstructions(constructions, settings.homepageOrder, settings.homepageHidden);
const items = ordered.map(toCatalogItem);
const formats = Array.from(new Set(items.map((item) => item.format))).map((value) => ({
  value,
  label: CONSTRUCTION_FORMAT_LABEL[value],
}));
const districts = Array.from(new Set(items.map((item) => item.district).filter((value): value is string => Boolean(value)))).sort((a, b) => a.localeCompare(b, "ru"));
const newsItems = news.map(toNewsView).slice(0, settings.newsHomeCount);
const hidden = new Set(settings.homepageHidden);
const visibleDocuments = documentCategories
  .map((category) => ({ ...category, constructions: category.constructions.filter((item) => !hidden.has(item.id)) }))
  .filter((category) => category.constructions.length > 0);
const mapApiKey = import.meta.env.PUBLIC_YANDEX_MAPS_API_KEY ?? "";

const title = `${BRAND_NAME} — наружная реклама на карте Грозного`;
const description = "Цифровой каталог наружной рекламы в Грозном: карта конструкций, стороны A/B/C, цены, трафик, доступность по датам и единая заявка по подборке.";
const organizationJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: BRAND_NAME,
  url: absUrl("/"),
  telephone: settings.phonePrimary,
  email: settings.email,
  address: {
    "@type": "PostalAddress",
    streetAddress: settings.address,
    addressLocality: "Грозный",
    addressCountry: "RU",
  },
};
---
<BaseLayout
  chrome={chrome}
  title={title}
  description={description}
  path="/"
  jsonLd={organizationJsonLd}
  current="home"
>
  <HomeHero
    featured={items[0]}
    constructionCount={constructions.length}
    developerCount={stats.developerCount}
    formats={formats}
    districts={districts}
  />
  <HomeInventory items={items} mapApiKey={mapApiKey} center={[43.318, 45.698]} />
  <ProcessSection />
  <BenefitsSection />
  <NewsSection items={newsItems} />
  <MaterialsSection categories={visibleDocuments} />
  <ContactSection chrome={chrome} />
  <script>
    import "../scripts/home";
  </script>
</BaseLayout>
