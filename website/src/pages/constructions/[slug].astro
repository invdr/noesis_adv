---
import ConstructionDetail from "../../components/construction/ConstructionDetail.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  fetchConstructionDocuments,
  fetchConstructions,
  fetchSiteSettings,
  type Construction,
} from "../../lib/api";
import { buildChrome } from "../../lib/chrome";
import { absUrl, BRAND_NAME } from "../../lib/site";

export async function getStaticPaths() {
  const constructions = await fetchConstructions();
  return constructions.map((construction) => ({ params: { slug: construction.slug }, props: { construction } }));
}

interface Props { construction: Construction; }
const { construction } = Astro.props;
const [documents, settings] = await Promise.all([
  fetchConstructionDocuments(construction.slug),
  fetchSiteSettings(),
]);
const chrome = buildChrome(settings);
const mapApiKey = import.meta.env.PUBLIC_YANDEX_MAPS_API_KEY ?? "";
const title = `${construction.name}${construction.code ? ` (${construction.code})` : ""} | ${BRAND_NAME}`;
const description = (construction.description || `${construction.address || "Грозный"}. Формат, стороны, фотографии, стоимость и календарь доступности рекламной конструкции.`).slice(0, 220);
const image = construction.cover?.url || construction.images[0]?.url;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: construction.name,
  sku: construction.code || construction.id,
  description,
  url: absUrl(`/constructions/${construction.slug}`),
  ...(image ? { image: absUrl(image) } : {}),
  ...(construction.address ? { areaServed: { "@type": "City", name: "Грозный" } } : {}),
  ...(construction.pricePerMonth != null ? {
    offers: {
      "@type": "Offer",
      price: construction.pricePerMonth,
      priceCurrency: "RUB",
      availability: "https://schema.org/LimitedAvailability",
      url: absUrl(`/constructions/${construction.slug}`),
    },
  } : {}),
};
---
<BaseLayout
  chrome={chrome}
  title={title}
  description={description}
  path={`/constructions/${construction.slug}`}
  image={image}
  jsonLd={jsonLd}
  current="other"
>
  <ConstructionDetail construction={construction} documents={documents} mapApiKey={mapApiKey} />
  <script>
    import "../../scripts/construction";
  </script>
</BaseLayout>
