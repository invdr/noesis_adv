---
import CatalogExplorer from "../components/catalog/CatalogExplorer.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { fetchConstructions, fetchSiteSettings, toCatalogItem } from "../lib/api";
import { buildChrome } from "../lib/chrome";
import { BRAND_NAME } from "../lib/site";

const [constructions, settings] = await Promise.all([fetchConstructions(), fetchSiteSettings()]);
const chrome = buildChrome(settings);
const items = constructions.map(toCatalogItem);
const mapApiKey = import.meta.env.PUBLIC_YANDEX_MAPS_API_KEY ?? "";
const title = `Каталог наружной рекламы в Грозном | ${BRAND_NAME}`;
const description = "Карта и каталог рекламных конструкций Грозного: фильтры по датам, формату, району, цене, подсветке, сторонам и фактической доступности.";
---
<BaseLayout chrome={chrome} title={title} description={description} path="/catalog" current="catalog">
  <CatalogExplorer items={items} mapApiKey={mapApiKey} />
  <script>
    import "../scripts/catalog";
  </script>
</BaseLayout>
