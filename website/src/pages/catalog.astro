---
// Публичный каталог с картой Грозного и фильтрами (Этап 3). Каталожные поля
// (формат/цена/район/координаты/стороны) запекаются из API на сборке — карточки
// сразу в статике (SEO/мгновенный рендер). Занятость на выбранный период
// дотягивается в браузере из /api/public/construction-availability и мёржится по
// id (карта раскрашивает пины, фильтр «только свободные» отсекает занятые).
import SiteHead from "../components/SiteHead.astro";
import Footer from "../components/Footer.astro";
import CookieBanner from "../components/CookieBanner.astro";
import Header from "../components/Header.astro";
import {
  fetchConstructions,
  fetchDocumentCategories,
  fetchSiteSettings,
  toCatalogItem,
} from "../lib/api";
import { buildChrome } from "../lib/chrome";
import { CONSTRUCTION_FORMAT_LABEL, orderHomepageConstructions } from "@noesis/contracts";

const apiUrl = import.meta.env.PUBLIC_API_URL ?? "http://localhost:3000";
const yandexMapsApiKey = import.meta.env.PUBLIC_YANDEX_MAPS_API_KEY ?? "";
const GROZNY_CENTER = [43.318, 45.698] as const;

const [constructions, docCategories, settings] = await Promise.all([
  fetchConstructions(),
  fetchDocumentCategories(),
  fetchSiteSettings(),
]);

const chrome = buildChrome(settings);
const s = chrome.s;
const hasDocs = docCategories.length > 0;

// Та же видимость/порядок, что на главной: скрытые не показываем и на карте.
const visible = orderHomepageConstructions(constructions, s.homepageOrder, s.homepageHidden);
const items = visible.map(toCatalogItem);

// Опции фильтров из фактических данных.
const formatsPresent = Array.from(new Set(items.map((i) => i.format))).map((key) => ({
  key,
  label: CONSTRUCTION_FORMAT_LABEL[key],
}));
const districtsPresent = Array.from(
  new Set(items.map((i) => i.district).filter((d): d is string => !!d)),
).sort((a, b) => a.localeCompare(b, "ru"));
const withCoords = items.filter((i) => i.lat != null && i.lng != null).length;

const catalog = {
  map: { apiKey: yandexMapsApiKey, center: GROZNY_CENTER, zoom: 12 },
  items,
};

const title = "Каталог рекламных конструкций на карте — Noesis";
const description =
  "Карта рекламных конструкций Грозного: фильтры по формату, цене, району и занятости на нужный период. Выберите сити-формат или щит и оставьте заявку.";
---
<!DOCTYPE html>
<html lang="ru">
<head>
<SiteHead title={title} description={description} path="/catalog" siteName={s.siteName} metrikaId={chrome.metrikaId} />
</head>
<body>

<Header chrome={chrome} showDocs={hasDocs} solid />

<main class="catalog-page">
  <section class="section section-white">
    <div class="wrap">
      <div class="section-head">
        <div>
          <div class="eyebrow"><span class="eyebrow-line"></span><span class="mono">{s.flatsEyebrow}</span></div>
          <h1 class="h2">Конструкции на карте Грозного</h1>
        </div>
        <p class="section-desc">Отфильтруйте по формату, цене и району, задайте период — карта покажет свободные и занятые стороны. Клик по пину подсветит карточку.</p>
      </div>

      <form class="catalog-filters" id="catalogFilters">
        <label class="catalog-field">
          <span class="catalog-field-label mono">Формат</span>
          <select name="format">
            <option value="">Все форматы</option>
            {formatsPresent.map((f) => (<option value={f.key}>{f.label}</option>))}
          </select>
        </label>

        {districtsPresent.length > 0 && (
          <label class="catalog-field">
            <span class="catalog-field-label mono">Район</span>
            <select name="district">
              <option value="">Все районы</option>
              {districtsPresent.map((d) => (<option value={d}>{d}</option>))}
            </select>
          </label>
        )}

        <label class="catalog-field">
          <span class="catalog-field-label mono">Цена от, ₽/мес</span>
          <input type="number" name="priceFrom" inputmode="numeric" min="0" step="1000" placeholder="0" />
        </label>
        <label class="catalog-field">
          <span class="catalog-field-label mono">до, ₽/мес</span>
          <input type="number" name="priceTo" inputmode="numeric" min="0" step="1000" placeholder="—" />
        </label>

        <label class="catalog-field">
          <span class="catalog-field-label mono">Период с</span>
          <input type="date" name="from" />
        </label>
        <label class="catalog-field">
          <span class="catalog-field-label mono">по</span>
          <input type="date" name="to" />
        </label>

        <label class="catalog-check">
          <input type="checkbox" name="onlyFree" disabled />
          <span>Только свободные на период</span>
        </label>

        <button type="button" class="btn btn-outline-dark catalog-reset" id="catalogReset">Сбросить</button>
      </form>

      <p class="catalog-status" id="catalogStatus" role="status" aria-live="polite"></p>

      <div class="catalog-layout">
        <div class="catalog-map-col">
          <div id="catalogMap" class="constructions-map" role="img" aria-label="Карта рекламных конструкций в Грозном">
            <p class="map-placeholder">Карта загружается…</p>
          </div>
          <div class="catalog-legend" id="catalogLegend" hidden>
            <span class="catalog-legend-item"><span class="catalog-dot catalog-dot--free"></span>свободна сторона</span>
            <span class="catalog-legend-item"><span class="catalog-dot catalog-dot--partial"></span>частично занята</span>
            <span class="catalog-legend-item"><span class="catalog-dot catalog-dot--busy"></span>занята</span>
          </div>
        </div>

        <div class="catalog-list-col">
          <div class="catalog-grid" id="catalogList">
            {items.map((item) => (
              <article class="project-card catalog-card" data-id={item.id}>
                <a class="project-card-media" href={item.href}>
                  <img src={item.img} srcset={item.imgSrcset} sizes="(max-width:899px) 100vw, 420px" alt={item.name} loading="lazy" />
                  <div class="project-card-shade"></div>
                  {item.badges.filter((b) => b.text).length > 0 && (
                    <span class="project-card-badges">
                      {item.badges.filter((b) => b.text).map((b) => (
                        <span class="project-badge" style={`background:${b.bg};color:${b.fg}`}>{b.text}</span>
                      ))}
                    </span>
                  )}
                  <div class="project-card-name-row">
                    <span class="project-card-name">{item.name}</span>
                    <span class="project-card-arrow">→</span>
                  </div>
                </a>
                <div class="project-card-body">
                  <div class="project-card-meta">
                    <div class="project-card-addr-col">
                      <span class="project-card-addr">{item.address}</span>
                      <span class="project-card-rooms mono">{item.formatLabel} · {item.sideLabel}</span>
                    </div>
                    <span class="project-card-price">{item.priceLabel}</span>
                  </div>
                  <div class="project-card-facts">
                    <span>{item.sizeLabel}</span>
                    <span>{item.lightingLabel}</span>
                    <span>{item.reachLabel}</span>
                  </div>
                  <p class="catalog-card-avail" data-avail hidden></p>
                  {item.lat != null && item.lng != null && (
                    <button type="button" class="catalog-card-map-btn" data-map-focus={item.id}>Показать на карте</button>
                  )}
                </div>
              </article>
            ))}
          </div>
          <p class="catalog-empty" id="catalogEmpty" hidden>Ничего не найдено — измените фильтры.</p>
        </div>
      </div>
    </div>
  </section>
</main>

<Footer chrome={chrome} showDocs={hasDocs} />

<CookieBanner />

<script is:inline define:vars={{ apiUrl, catalog, mapCount: withCoords }}>
  window.NOESIS_API_URL = apiUrl;
  window.NOESIS_CATALOG = catalog;
  window.NOESIS_CATALOG_MAP_COUNT = mapCount;
</script>
<script is:inline src="/js/catalog.js"></script>
</body>
</html>
