---
import NewsArticle from "../../components/news/NewsArticle.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { fetchNews, fetchSiteSettings, toNewsView, type News } from "../../lib/api";
import { buildChrome } from "../../lib/chrome";
import { absUrl, BRAND_NAME } from "../../lib/site";

export async function getStaticPaths() {
  const news = await fetchNews();
  return news.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}
interface Props { item: News; }
const { item } = Astro.props;
const view = toNewsView(item);
const chrome = buildChrome(await fetchSiteSettings());
const title = `${view.title} | ${BRAND_NAME}`;
const description = (item.excerpt || view.body[0] || view.title).slice(0, 220);
const published = Number.isNaN(new Date(item.date).getTime()) ? undefined : new Date(item.date).toISOString();
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  headline: view.title,
  ...(published ? { datePublished: published } : {}),
  ...(view.tag ? { articleSection: view.tag } : {}),
  ...(view.img ? { image: absUrl(view.img) } : {}),
  mainEntityOfPage: absUrl(`/news/${item.slug}`),
  publisher: { "@type": "Organization", name: BRAND_NAME },
};
---
<BaseLayout
  chrome={chrome}
  title={title}
  description={description}
  path={`/news/${item.slug}`}
  image={view.img || undefined}
  type="article"
  jsonLd={jsonLd}
  current="news"
>
  <NewsArticle item={view} />
</BaseLayout>
