---
import NewsIndex from "../../components/news/NewsIndex.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { fetchNews, fetchSiteSettings, toNewsView } from "../../lib/api";
import { buildChrome } from "../../lib/chrome";
import { BRAND_NAME } from "../../lib/site";

const [news, settings] = await Promise.all([fetchNews(), fetchSiteSettings()]);
const chrome = buildChrome(settings);
const title = `Кейсы и новости | ${BRAND_NAME}`;
const description = "Кейсы, новости и материалы NOESIS |ad о наружной рекламе и рекламных конструкциях в Грозном.";
---
<BaseLayout chrome={chrome} title={title} description={description} path="/news" current="news">
  <NewsIndex items={news.map(toNewsView)} />
</BaseLayout>
