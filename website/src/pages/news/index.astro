---
// Страница «Все акции и новости» /news. Markup повторяет наложение newsListPage
// с главной; карточки — настоящие ссылки на /news/<slug>.
import SiteHead from "../../components/SiteHead.astro";
import Footer from "../../components/Footer.astro";
import CookieBanner from "../../components/CookieBanner.astro";
import { fetchNews, fetchSiteSettings, toNewsView } from "../../lib/api";
import { buildChrome } from "../../lib/chrome";

const [newsRaw, settings] = await Promise.all([fetchNews(), fetchSiteSettings()]);
const news = newsRaw.map(toNewsView);
const chrome = buildChrome(settings);
const s = chrome.s;

const title = "Акции и новости — Noesis";
const description =
  "Акции, рассрочка и новости Noesis: специальные условия на квартиры в жилых комплексах Грозного напрямую от застройщика.";
---
<!DOCTYPE html>
<html lang="ru">
<head>
<SiteHead title={title} description={description} path="/news" siteName={s.siteName} metrikaId={chrome.metrikaId} />
</head>
<body>
<div class="project-page-bar">
  <div class="wrap-narrow project-bar-inner">
    <a class="bar-icon-btn bar-icon-back" href="/" aria-label="На главную"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5"></path><path d="M12 19l-7-7 7-7"></path></svg></a>
    <a href="/"><img src="/assets/logo-blue.png" alt={s.siteName}></a>
    <a href={chrome.phoneHref} class="bar-icon-btn bar-icon-call" aria-label="Позвонить"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"></path></svg></a>
  </div>
</div>

<div class="wrap-narrow news-list-body">
  <div class="eyebrow"><span class="eyebrow-line"></span><span class="mono">Акции и новости</span></div>
  <h1>Все акции и новости</h1>
  <div class="news-grid">
    {news.map((n) => (
      <a class="news-card" href={n.href}>
        <div class="news-card-media">
          <img src={n.img} srcset={n.imgSrcset || undefined} sizes={n.imgSrcset ? "(max-width:719px) 100vw, 380px" : undefined} alt={n.title} loading="lazy">
          <div class="news-card-shade"></div>
          <span class="news-card-tag mono">{n.tag}</span>
        </div>
        <div class="news-card-body">
          <span class="news-card-title">{n.title}</span>
          <span class="news-card-desc">{n.excerpt}</span>
          <span class="news-card-link">Подробнее <span>→</span></span>
        </div>
      </a>
    ))}
  </div>
</div>

<Footer chrome={chrome} />
<CookieBanner />

<script is:inline src="/js/page.js"></script>
</body>
</html>
