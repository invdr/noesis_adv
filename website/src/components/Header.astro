---
import type { Chrome } from "../lib/chrome";
import BrandMark from "./BrandMark.astro";

interface Props {
  chrome: Chrome;
  current?: "home" | "catalog" | "news" | "materials" | "selection" | "other";
}

const { chrome, current = "other" } = Astro.props;
const nav = [
  { href: "/catalog", label: "Каталог", key: "catalog" },
  { href: "/catalog#map", label: "Карта", key: "map" },
  { href: "/#process", label: "Как это работает", key: "process" },
  { href: "/news", label: "Кейсы", key: "news" },
  { href: "/materials", label: "Материалы", key: "materials" },
];
---
<header class="header" data-site-header>
  <div class="header__inner container">
    <a class="header__brand" href="/" aria-label="NOESIS ad — на главную">
      <BrandMark />
    </a>

    <nav class="header__nav" aria-label="Основная навигация">
      {nav.map((item) => (
        <a
          href={item.href}
          aria-current={current === item.key ? "page" : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="header__actions">
      <a class="header__phone" href={chrome.phoneHref}>{chrome.phoneDisplay}</a>
      <a class="header__selection" href="/selection" aria-current={current === "selection" ? "page" : undefined}>
        <span class="header__selection-label">Подборка</span>
        <span class="header__count" data-shortlist-count aria-label="Позиций в подборке">0</span>
      </a>
      <a class="header__cta" href="/catalog">Подобрать размещение</a>
      <button
        class="header__menu-button"
        type="button"
        aria-label="Открыть меню"
        aria-controls="mobile-navigation"
        aria-expanded="false"
        data-menu-toggle
      >
        <span></span><span></span>
      </button>
    </div>
  </div>

  <div class="mobile-nav" id="mobile-navigation" data-mobile-menu hidden>
    <div class="mobile-nav__panel">
      <div class="mobile-nav__top">
        <BrandMark />
        <button type="button" aria-label="Закрыть меню" data-menu-close>Закрыть</button>
      </div>
      <nav aria-label="Мобильная навигация">
        <a href="/">Главная</a>
        {nav.map((item) => <a href={item.href}>{item.label}</a>)}
        <a href="/#contacts">Контакты</a>
      </nav>
      <div class="mobile-nav__bottom">
        <a href="/selection">Подборка <span data-shortlist-count>0</span></a>
        <a href={chrome.phoneHref}>{chrome.phoneDisplay}</a>
      </div>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    z-index: 100;
    top: 0;
    min-height: var(--header-height);
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--canvas) 94%, transparent);
    backdrop-filter: blur(8px);
  }

  .header__inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    min-height: var(--header-height);
    gap: clamp(20px, 3vw, 56px);
  }

  .header__brand {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
  }

  .header__nav {
    display: flex;
    align-items: center;
    gap: clamp(16px, 1.8vw, 28px);
  }

  .header__nav a {
    position: relative;
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    color: var(--ink);
    font-size: 14px;
    font-weight: 500;
    white-space: nowrap;
  }

  .header__nav a::after {
    position: absolute;
    right: 0;
    bottom: 8px;
    left: 0;
    height: 2px;
    transform: scaleX(0);
    transform-origin: left;
    background: var(--accent);
    content: "";
    transition: transform 180ms ease;
  }

  .header__nav a:hover { color: var(--accent); }
  .header__nav a:hover::after,
  .header__nav a[aria-current="page"]::after {
    transform: scaleX(1);
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .header__phone {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }
  .header__phone:hover { color: var(--accent); }

  .header__selection {
    display: inline-flex;
    min-height: 38px;
    align-items: center;
    gap: 8px;
    padding: 0 14px;
    color: var(--ink);
    background: var(--paper);
    border: 1.5px solid var(--ink);
    border-radius: var(--radius-sm);
    font-size: 13px;
    font-weight: 600;
    transition: background 160ms ease, color 160ms ease;
  }
  .header__selection:hover { color: #fbfaf5; background: var(--ink); }

  .header__count {
    display: inline-flex;
    min-width: 20px;
    height: 20px;
    align-items: center;
    justify-content: center;
    padding-inline: 5px;
    color: #fbfaf5;
    background: var(--accent);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
  }

  .header__cta {
    display: inline-flex;
    min-height: 38px;
    align-items: center;
    padding: 0 16px;
    color: #fbfaf5;
    background: var(--accent);
    border: 1.5px solid var(--accent);
    border-radius: var(--radius-sm);
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
    transition: background 160ms ease, border-color 160ms ease;
  }
  .header__cta:hover { background: var(--accent-hover); border-color: var(--accent-hover); }

  .header__menu-button {
    display: none;
    width: 46px;
    height: 46px;
    place-content: center;
    gap: 7px;
    padding: 0;
    color: var(--ink);
    background: transparent;
  }

  .header__menu-button span {
    width: 23px;
    height: 2px;
    background: currentColor;
  }

  .mobile-nav {
    position: fixed;
    z-index: 200;
    inset: 0;
    display: block;
    width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    overflow: hidden;
    background: rgba(34, 32, 28, 0.48);
    overscroll-behavior: contain;
  }

  .mobile-nav[hidden] { display: none !important; }

  .mobile-nav__panel {
    width: min(100%, 430px);
    height: 100%;
    margin-left: auto;
    padding: 20px;
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--canvas);
    box-shadow: -20px 0 60px rgba(34, 32, 28, 0.18);
  }

  .mobile-nav__top,
  .mobile-nav__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .mobile-nav__top button {
    min-height: 44px;
    padding: 0 12px;
    color: var(--muted);
    background: transparent;
    font-size: 13px;
    font-weight: 600;
  }

  .mobile-nav nav {
    display: grid;
    margin-block: 44px;
  }

  .mobile-nav nav a {
    display: flex;
    min-height: 56px;
    align-items: center;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-display);
    font-size: clamp(22px, 6vw, 30px);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.01em;
  }

  .mobile-nav__bottom {
    align-items: stretch;
    flex-direction: column;
  }

  .mobile-nav__bottom a {
    display: flex;
    min-height: 52px;
    align-items: center;
    justify-content: center;
    gap: 10px;
    border: 1.5px solid var(--line-strong);
    border-radius: var(--radius-sm);
    font-weight: 600;
  }

  .mobile-nav__bottom a:first-child {
    color: #fbfaf5;
    background: var(--accent);
    border-color: var(--accent);
  }

  @media (max-width: 1180px) {
    .header__nav,
    .header__phone,
    .header__cta { display: none; }
    .header__inner { grid-template-columns: auto 1fr; }
    .header__actions { justify-content: flex-end; }
    .header__menu-button { display: grid; }
  }

  @media (max-width: 560px) {
    .header__selection {
      width: 40px;
      justify-content: center;
      padding: 0;
    }
    .header__selection-label { display: none; }
    .header__count { min-width: 18px; height: 18px; }
  }
</style>
