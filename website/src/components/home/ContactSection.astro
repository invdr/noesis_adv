---
import type { Chrome } from "../../lib/chrome";
import LeadForm from "../LeadForm.astro";
interface Props { chrome: Chrome; }
const { chrome } = Astro.props;
const { s } = chrome;
---
<section class="contact" id="request">
  <div class="container">
    <div class="contact__details">
      <p>{s.contactsEyebrow}</p>
      <div>
        <a href={chrome.phoneHref}>{chrome.phoneDisplay}</a>
        <a href={chrome.secondary.href}>{chrome.secondary.label}</a>
        <a href={`mailto:${s.email}`}>{s.email}</a>
      </div>
      <div>
        <span>{s.address}</span>
        <span>{s.workHoursWeekday}<br />{s.workHoursSaturday}</span>
      </div>
    </div>
    <LeadForm
      title={s.contactsTitle}
      description="Оставьте контакты и параметры кампании. Если в подборке уже есть позиции, они автоматически приложатся к заявке."
      source="contacts"
      variant="light"
    />
  </div>
</section>

<style>
  .contact { padding: clamp(60px, 8vw, 108px) 0; background: var(--surface); }
  .contact__details {
    display: grid;
    grid-template-columns: 0.55fr 1fr 1fr;
    gap: 30px;
    margin-bottom: 28px;
    padding: 0 6px;
  }
  .contact__details > p { margin: 0; color: var(--accent); font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; }
  .contact__details > div { display: grid; align-content: start; gap: 6px; }
  .contact__details a,
  .contact__details span { width: fit-content; color: var(--muted); font-size: 13px; }
  .contact__details a:hover { color: var(--accent); }
  @media (max-width: 760px) { .contact__details { grid-template-columns: 1fr; gap: 20px; } }
</style>
