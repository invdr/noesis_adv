---
import SectionHeading from "../SectionHeading.astro";
const steps = [
  { n: "01", title: "Задайте период", text: "Выберите даты, формат и район. Каталог покажет подходящие локации и статусы сторон." },
  { n: "02", title: "Соберите подборку", text: "Сравните фотографии, направление обзора, трафик и стоимость. Добавьте нужные стороны." },
  { n: "03", title: "Получите подтверждение", text: "Одна заявка передаёт менеджеру весь shortlist. Он проверит остатки и согласует размещение." },
];
---
<section class="process" id="process">
  <div class="container process__inner">
    <SectionHeading
      eyebrow="Как работает размещение"
      title="От карты до согласованного размещения"
      description="Сайт помогает выбрать инвентарь. Бронирование возникает только после проверки и подтверждения менеджером."
    />
    <ol class="process__grid">
      {steps.map((step) => (
        <li>
          <span>{step.n}</span>
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .process { padding: clamp(56px, 7vw, 88px) 0; background: var(--canvas); }
  .process__inner { display: grid; gap: clamp(28px, 4vw, 44px); }
  .process__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin: 0; padding: 0; list-style: none; }
  .process li {
    display: grid;
    align-content: start;
    gap: 8px;
    padding: 26px;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
  }
  .process li > span { color: var(--accent); font-family: var(--font-mono); font-size: 15px; font-weight: 600; margin-bottom: 6px; }
  .process h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(19px, 1.7vw, 22px);
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .process li p { margin: 0; color: var(--muted); font-size: 15px; line-height: 1.5; }
  @media (max-width: 820px) { .process__grid { grid-template-columns: 1fr; } }
</style>
