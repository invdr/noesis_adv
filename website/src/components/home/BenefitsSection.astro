---
import SectionHeading from "../SectionHeading.astro";
const benefits = [
  { code: "MAP", title: "Локация видна сразу", text: "Адрес, район и координаты помогают оценить маршрут и окружение до разговора с менеджером." },
  { code: "SIDE", title: "Каждая сторона отдельно", text: "У A, B и C могут отличаться направление обзора, фотография, трафик, цена и занятость." },
  { code: "DATE", title: "Период проверяется по броням", text: "Статус строится по фактическим интервалам: свободно, частично занято или занято." },
  { code: "ONE", title: "Одна заявка на весь shortlist", text: "Не нужно отправлять карточки по одной: подборка сохраняется и передаётся менеджеру целиком." },
];
---
<section class="benefits" id="about">
  <div class="container">
    <div class="benefits__heading">
      <SectionHeading eyebrow="NOESIS |ad" title="Инвентарь как цифровой городской слой" description="Не витрина агентства, а рабочий инструмент для медиапланирования: точка, сторона, период, условия." />
      <p>Мы сопровождаем подбор и размещение наружной рекламы в Грозном — от первичного списка до подтверждения свободных поверхностей.</p>
    </div>
    <div class="benefits__grid">
      {benefits.map((item) => (
        <article>
          <span>{item.code}</span>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .benefits { padding: clamp(80px, 10vw, 150px) 0; background: var(--paper); }
  .benefits__heading { display: grid; grid-template-columns: 1.4fr 0.6fr; align-items: end; gap: 40px; }
  .benefits__heading > p { margin: 0; color: var(--muted); font-size: 15px; }
  .benefits__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; margin-top: 60px; background: var(--line); border: 1px solid var(--line); }
  .benefits article { min-height: 300px; padding: 24px; background: var(--paper); }
  .benefits article > span { color: var(--accent); font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.12em; }
  .benefits h3 { margin: 100px 0 14px; font-size: clamp(20px, 2vw, 28px); letter-spacing: -0.04em; }
  .benefits article p { margin: 0; color: var(--muted); font-size: 13px; }
  @media (max-width: 980px) { .benefits__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 700px) { .benefits__heading { grid-template-columns: 1fr; } }
  @media (max-width: 520px) {
    .benefits__grid { grid-template-columns: 1fr; }
    .benefits article { min-height: 240px; }
    .benefits h3 { margin-top: 64px; }
  }
</style>
