---
import SectionHeading from "../SectionHeading.astro";
const benefits = [
  { title: "Локация видна сразу", text: "Адрес, район и координаты помогают оценить маршрут и окружение до разговора с менеджером." },
  { title: "Каждая сторона отдельно", text: "У A, B и C могут отличаться направление обзора, фотография, трафик, цена и занятость." },
  { title: "Период проверяется по броням", text: "Статус строится по фактическим интервалам: свободно, частично занято или занято." },
  { title: "Прозрачные характеристики", text: "Габариты, трафик, направление обзора и подсветка — без запросов «уточните у менеджера»." },
  { title: "Производство и монтаж", text: "Печать, монтаж и замена макетов сопровождаются в рамках одного договора." },
  { title: "Одна заявка на весь shortlist", text: "Подборка сохраняется и передаётся менеджеру целиком — не нужно отправлять карточки по одной." },
];
---
<section class="benefits" id="about">
  <div class="container">
    <SectionHeading
      eyebrow="Почему NOESIS"
      title="Город как медиасистема — с точными данными по каждой стороне"
      tone="light"
    />
    <div class="benefits__grid">
      {benefits.map((item) => (
        <article>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .benefits { padding: clamp(60px, 8vw, 96px) 0; color: #fbfaf5; background: var(--dark); }
  .benefits__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: 40px;
    border-top: 1px solid var(--dark-line);
  }
  .benefits article {
    padding: 24px;
    border-bottom: 1px solid var(--dark-line);
  }
  .benefits article:nth-child(3n + 1) { padding-left: 0; }
  .benefits h3 { margin: 0 0 6px; font-size: 17px; font-weight: 600; }
  .benefits article p { margin: 0; color: var(--faint); font-size: 14px; line-height: 1.5; }
  @media (max-width: 900px) { .benefits__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) {
    .benefits__grid { grid-template-columns: 1fr; }
    .benefits article:nth-child(3n + 1) { padding-left: 24px; }
  }
</style>
