---
import type { CatalogItem } from "../../lib/api";
import { jsonForHtml } from "../../lib/json";
import ConstructionCard from "../ConstructionCard.astro";
import MapCanvas from "../MapCanvas.astro";
import SectionHeading from "../SectionHeading.astro";

interface Props {
  items: CatalogItem[];
  mapApiKey: string;
  center: readonly [number, number];
  eyebrow?: string;
  title?: string;
}
const {
  items,
  mapApiKey,
  center,
  eyebrow = "Каталог и география",
  title = "Локации и условия размещения",
} = Astro.props;
const preview = items.slice(0, 4);
const data = jsonForHtml({ items, map: { apiKey: mapApiKey, center, zoom: 12 } });
---
<section class="inventory" id="inventory">
  <div class="container inventory__heading">
    <SectionHeading
      eyebrow={eyebrow}
      title={title}
      description="Каждая позиция привязана к адресу, стороне и инвентарному коду. Задайте даты — статусы обновятся по данным бронирований."
    />
    <a href="/catalog">Все конструкции <span aria-hidden="true">→</span></a>
  </div>

  <div class="inventory__layout container">
    <div class="inventory__list" data-home-list>
      {preview.map((item) => <ConstructionCard item={item} mapAction variant="horizontal" />)}
    </div>
    <div class="inventory__map" id="map">
      <div class="inventory__map-head">
        <div><span>Карта Грозного</span><strong>{items.filter((item) => item.lat != null && item.lng != null).length} точек с координатами</strong></div>
        <div class="inventory__legend" aria-label="Обозначения статусов">
          <span><i></i> Свободно</span><span><i></i> Частично</span><span><i></i> Занято</span>
        </div>
      </div>
      <MapCanvas id="home-map" />
      <p class="inventory__map-status" data-home-map-status role="status" aria-live="polite"></p>
    </div>
  </div>
  <script is:inline id="home-data" type="application/json" set:html={data}></script>
</section>

<style>
  .inventory { padding: clamp(56px, 7vw, 88px) 0 clamp(56px, 7vw, 88px); }
  .inventory__heading { display: flex; align-items: end; justify-content: space-between; gap: 24px; margin-bottom: 30px; }
  .inventory__heading > a {
    display: inline-flex;
    min-height: 44px;
    flex: 0 0 auto;
    align-items: center;
    justify-content: space-between;
    gap: 22px;
    padding: 0 16px;
    border: 1.5px solid var(--ink);
    border-radius: var(--radius-sm);
    font-size: 13px;
    font-weight: 600;
  }
  .inventory__heading > a:hover { color: #fbfaf5; background: var(--ink); }
  .inventory__layout { display: grid; grid-template-columns: minmax(380px, 0.9fr) minmax(460px, 1.1fr); align-items: start; gap: 22px; }
  /* Горизонтальные карточки — одна колонка, конструкции идут лентой. */
  .inventory__list { display: grid; grid-template-columns: 1fr; gap: 14px; }
  .inventory__map { position: sticky; top: calc(var(--header-height) + 18px); min-width: 0; }
  .inventory__map-head { display: flex; min-height: 62px; align-items: center; justify-content: space-between; gap: 16px; padding: 0 4px 14px; }
  .inventory__map-head > div:first-child { display: grid; gap: 2px; }
  .inventory__map-head span { color: var(--muted); font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; }
  .inventory__map-head strong { font-size: 13px; }
  .inventory__legend { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 8px 12px; }
  .inventory__legend span { display: inline-flex; align-items: center; gap: 5px; letter-spacing: 0; text-transform: none; }
  .inventory__legend i { width: 7px; height: 7px; background: var(--positive); border-radius: 999px; }
  .inventory__legend span:nth-child(2) i { background: var(--warning); }
  .inventory__legend span:nth-child(3) i { background: var(--busy); }
  .inventory__map-status { min-height: 22px; margin: 10px 4px 0; color: var(--muted); font-size: 11px; }
  @media (max-width: 1220px) {
    .inventory__layout { grid-template-columns: minmax(320px, 0.9fr) minmax(440px, 1.1fr); }
  }
  @media (max-width: 900px) {
    .inventory__heading { align-items: start; flex-direction: column; }
    .inventory__layout { grid-template-columns: 1fr; }
    .inventory__map { position: static; grid-row: 1; }
  }
  @media (max-width: 620px) {
    .inventory { padding-top: 76px; }
    .inventory__map-head { align-items: start; flex-direction: column; }
    .inventory__legend { justify-content: flex-start; }
  }
</style>
