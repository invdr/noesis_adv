---
interface Props {
  constructionCount: number;
  developerCount: number;
  formats: { value: string; label: string }[];
  districts: string[];
  // Тексты hero — из настроек сайта (CRM); дефолты повторяют дизайн-копирайт.
  eyebrow?: string;
  titleLine1?: string;
  titleLine2?: string;
  subtitle?: string;
  ctaPrimary?: string;
  ctaSecondary?: string;
}

const {
  constructionCount,
  developerCount,
  formats,
  districts,
  eyebrow = "Наружная реклама в Грозном",
  titleLine1 = "Займите нужную",
  titleLine2 = "точку города",
  subtitle = "Выберите рекламные конструкции на карте, сравните стороны и проверьте доступность на нужные даты. NOESIS |ad собирает запрос в одну подборку — условия подтверждает менеджер.",
  ctaPrimary = "Открыть карту",
  ctaSecondary = "Смотреть каталог",
} = Astro.props;
const heroTitle = [titleLine1, titleLine2].filter(Boolean).join(" ");

// Декоративные пины для тизера карты (реальная Яндекс.Карта — в каталоге).
const pins = [
  { num: "014", x: 40, y: 53, status: "free" },
  { num: "022", x: 57, y: 37, status: "free" },
  { num: "036", x: 31, y: 70, status: "partial" },
  { num: "047", x: 15, y: 15, status: "busy" },
  { num: "064", x: 62, y: 30, status: "busy" },
];
---
<section class="hero">
  <div class="hero__grid container">
    <div class="hero__content">
      <p class="hero__eyebrow"><span aria-hidden="true"></span>{eyebrow}</p>
      <h1>{heroTitle}</h1>
      <p class="hero__lead">{subtitle}</p>
      <div class="hero__actions">
        <a class="hero__btn hero__btn--primary" href="/catalog#map">{ctaPrimary}</a>
        <a class="hero__btn hero__btn--ghost" href="/catalog">{ctaSecondary}</a>
      </div>
      <dl class="hero__stats" aria-label="Данные каталога">
        {constructionCount > 0 && <div><dt>{constructionCount}</dt><dd>конструкций в сети</dd></div>}
        {districts.length > 0 && <div><dt>{districts.length}</dt><dd>района города</dd></div>}
        {developerCount > 0 && <div><dt class="hero__stats-accent">{developerCount}</dt><dd>владельцев сети</dd></div>}
      </dl>
    </div>

    <a class="hero__visual" href="/catalog#map" aria-label="Открыть карту конструкций в каталоге">
      <div class="hero__map">
        <svg class="hero__map-svg" viewBox="0 0 800 640" preserveAspectRatio="none" role="img" aria-label="Схематичная карта Грозного с рекламными конструкциями">
          <rect width="800" height="640" fill="#eae6da"></rect>
          <g fill="#e2ddce">
            <rect x="60" y="60" width="150" height="100" rx="4"></rect><rect x="250" y="90" width="130" height="120" rx="4"></rect>
            <rect x="90" y="220" width="170" height="130" rx="4"></rect><rect x="300" y="260" width="120" height="100" rx="4"></rect>
            <rect x="120" y="420" width="180" height="120" rx="4"></rect><rect x="350" y="430" width="140" height="110" rx="4"></rect>
            <rect x="560" y="120" width="150" height="110" rx="4"></rect><rect x="580" y="300" width="140" height="120" rx="4"></rect>
            <rect x="540" y="470" width="170" height="100" rx="4"></rect>
          </g>
          <path d="M 470 0 C 458 120 516 210 498 330 C 482 450 542 540 532 640" stroke="#c5d2ce" stroke-width="16" fill="none"></path>
          <path d="M 40 520 L 760 170" stroke="#d5cfc0" stroke-width="13" fill="none"></path>
          <path d="M 40 520 L 760 170" stroke="#fbfaf5" stroke-width="9" fill="none"></path>
          <path d="M 210 0 L 268 640" stroke="#fbfaf5" stroke-width="7" fill="none"></path>
          <path d="M 0 330 L 800 368" stroke="#fbfaf5" stroke-width="6" fill="none"></path>
          <path d="M 0 130 L 420 88" stroke="#fbfaf5" stroke-width="5" fill="none"></path>
          <text x="330" y="352" font-family="JetBrains Mono" font-size="12" fill="#98937f" transform="rotate(-26 330 352)">пр. В.В. Путина</text>
          <text x="600" y="352" font-family="JetBrains Mono" font-size="11" fill="#98937f">пр. Мохаммеда Али</text>
          <text x="60" y="118" font-family="JetBrains Mono" font-size="11" fill="#98937f">ул. Маяковского</text>
          <text x="500" y="90" font-family="JetBrains Mono" font-size="11" fill="#afc0bb" transform="rotate(80 500 90)">р. Сунжа</text>
        </svg>
        {pins.map((pin) => (
          <span class="hero__pin" style={`left:${pin.x}%;top:${pin.y}%`}>
            {pin.num}<span class="hero__pin-dot" data-status={pin.status}></span>
          </span>
        ))}
        <div class="hero__legend">
          <span><i data-status="free"></i>свободно</span>
          <span><i data-status="partial"></i>частично</span>
          <span><i data-status="busy"></i>занято</span>
        </div>
        <div class="hero__coord">Грозный · центр · 43.318 N, 45.698 E</div>
      </div>
      <div class="hero__map-foot">
        <span>Открыть карту с фильтрами</span><span aria-hidden="true">→</span>
      </div>
    </a>
  </div>

  <div class="hero__search-wrap container">
    <form class="hero__search" action="/catalog" method="get" data-quick-search>
      <div class="hero__search-heading">
        <span>Быстрый подбор</span>
        <strong>Задайте основные параметры</strong>
      </div>
      <label>
        <span>Начало</span>
        <input type="date" name="from" data-default-from />
      </label>
      <label>
        <span>Окончание</span>
        <input type="date" name="to" data-default-to />
      </label>
      <label>
        <span>Формат</span>
        <select name="format">
          <option value="">Любой формат</option>
          {formats.map((option) => <option value={option.value}>{option.label}</option>)}
        </select>
      </label>
      <label>
        <span>Район</span>
        <select name="district">
          <option value="">Весь Грозный</option>
          {districts.map((district) => <option value={district}>{district}</option>)}
        </select>
      </label>
      <button type="submit">Показать варианты <span aria-hidden="true">→</span></button>
    </form>
  </div>
</section>

<style>
  .hero {
    padding: clamp(24px, 3vw, 40px) 0 clamp(28px, 4vw, 48px);
    background: var(--canvas);
  }
  .hero__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: clamp(28px, 4vw, 48px);
  }
  .hero__content { display: flex; min-width: 0; flex-direction: column; padding-inline-start: clamp(16px, 3vw, 56px); }
  .hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 18px;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .hero__eyebrow span { width: 22px; height: 2px; background: currentColor; }
  .hero h1 {
    max-width: 720px;
    margin: 0 0 16px;
    font-family: var(--font-display);
    font-size: clamp(40px, 5vw, 58px);
    font-weight: 600;
    letter-spacing: 0.01em;
    line-height: 1.03;
    text-transform: uppercase;
    text-wrap: balance;
  }
  .hero__lead { max-width: 560px; margin: 0 0 24px; color: var(--muted); font-size: clamp(15px, 1.1vw, 17px); line-height: 1.5; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 14px; margin-bottom: 28px; }
  .hero__btn {
    display: inline-flex;
    min-height: 50px;
    align-items: center;
    padding: 0 28px;
    border-radius: var(--radius-sm);
    font-size: 16px;
    font-weight: 600;
  }
  .hero__btn--primary { color: #fbfaf5; background: var(--accent); }
  .hero__btn--primary:hover { background: var(--accent-hover); }
  .hero__btn--ghost { color: var(--ink); background: transparent; border: 1.5px solid var(--ink); }
  .hero__btn--ghost:hover { color: #fbfaf5; background: var(--ink); }
  .hero__stats { display: flex; flex-wrap: wrap; gap: 20px 36px; margin: 0; }
  .hero__stats div { display: grid; gap: 2px; }
  .hero__stats dt { font-family: var(--font-display); font-size: 34px; font-weight: 600; color: var(--ink); }
  .hero__stats dt.hero__stats-accent { color: var(--accent); }
  .hero__stats dd { margin: 0; color: var(--muted); font-size: 13px; }

  .hero__visual {
    display: block;
    overflow: hidden;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: 0 14px 36px rgba(34, 32, 28, 0.14);
  }
  .hero__map { position: relative; height: clamp(320px, 30vw, 400px); background: var(--map); }
  .hero__map-svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hero__pin {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 4px 9px;
    transform: translate(-50%, -50%);
    background: var(--dark);
    color: #fbfaf5;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    box-shadow: 0 2px 8px rgba(34, 32, 28, 0.3);
  }
  .hero__pin-dot { width: 8px; height: 8px; border-radius: 99px; }
  .hero__pin-dot[data-status="free"],
  .hero__legend i[data-status="free"] { background: var(--positive); }
  .hero__pin-dot[data-status="partial"],
  .hero__legend i[data-status="partial"] { background: var(--warning); }
  .hero__pin-dot[data-status="busy"],
  .hero__legend i[data-status="busy"] { background: var(--busy); }
  .hero__legend {
    position: absolute;
    left: 14px;
    bottom: 14px;
    display: flex;
    gap: 14px;
    padding: 10px 14px;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    font-size: 12px;
    font-weight: 500;
  }
  .hero__legend span { display: flex; align-items: center; gap: 6px; }
  .hero__legend i { width: 9px; height: 9px; border-radius: 99px; }
  .hero__coord {
    position: absolute;
    right: 14px;
    top: 14px;
    padding: 8px 12px;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted);
  }
  .hero__map-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 18px;
    border-top: 1px solid var(--line);
    font-size: 14px;
    font-weight: 600;
    color: var(--ink);
  }
  .hero__visual:hover .hero__map-foot { color: var(--accent); }
  .hero__map-foot span:last-child { font-family: var(--font-mono); }

  .hero__search-wrap { margin-top: clamp(24px, 3vw, 36px); }
  .hero__search {
    display: grid;
    grid-template-columns: minmax(180px, 1.4fr) repeat(4, minmax(120px, 0.9fr)) minmax(160px, 1fr);
    align-items: end;
    gap: 14px;
    padding: 22px 24px;
    background: var(--dark);
    border-radius: var(--radius-lg);
  }
  .hero__search-heading { display: grid; align-self: center; gap: 4px; }
  .hero__search-heading span,
  .hero__search label > span {
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .hero__search-heading strong { color: #fbfaf5; font-size: 15px; font-weight: 600; }
  .hero__search label { display: grid; gap: 7px; }
  .hero__search input,
  .hero__search select {
    width: 100%;
    min-width: 0;
    min-height: 46px;
    padding: 0 12px;
    color: #fbfaf5;
    background: var(--dark-surface);
    border: 1.5px solid var(--dark-line);
    border-radius: var(--radius-sm);
    font-size: 14px;
    font-weight: 500;
  }
  .hero__search input:focus,
  .hero__search select:focus { border-color: var(--accent); outline: none; }
  .hero__search input[type="date"] { color-scheme: dark; }
  .hero__search button {
    display: flex;
    min-height: 46px;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 0 22px;
    color: #fbfaf5;
    background: var(--accent);
    border-radius: var(--radius-sm);
    font-size: 15px;
    font-weight: 600;
  }
  .hero__search button:hover { background: var(--accent-strong); }

  @media (max-width: 1180px) {
    .hero__search { grid-template-columns: repeat(3, 1fr); }
    .hero__search-heading { grid-column: 1 / -1; }
  }
  @media (max-width: 860px) {
    .hero__grid { grid-template-columns: 1fr; }
    .hero__content { padding-inline-start: 0; }
    .hero__search { grid-template-columns: repeat(2, 1fr); }
    .hero__search-heading,
    .hero__search button { grid-column: 1 / -1; }
  }
  @media (max-width: 520px) {
    .hero h1 { font-size: clamp(34px, 11vw, 46px); }
    .hero__actions { display: grid; }
    .hero__btn { justify-content: center; }
    .hero__search { grid-template-columns: 1fr; }
    .hero__legend { flex-wrap: wrap; gap: 8px 12px; }
  }
</style>
