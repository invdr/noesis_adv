---
interface Props {
  constructionCount: number;
  developerCount: number;
  formats: { value: string; label: string }[];
  districts: string[];
}

const { constructionCount, developerCount, formats, districts } = Astro.props;
const heroImage = "/assets/city-format-noesis-v2.png";
---
<section class="hero">
  <div class="hero__grid container">
    <div class="hero__content">
      <p class="hero__eyebrow">Грозный · городской рекламный инвентарь</p>
      <h1>Наружная реклама <em>на карте города</em></h1>
      <p class="hero__lead">
        Найдите конструкцию, сравните стороны и проверьте свободные даты. NOESIS |ad собирает запрос в одну подборку — условия подтверждает менеджер.
      </p>
      <div class="hero__actions">
        <a href="/catalog">Открыть каталог <span aria-hidden="true">→</span></a>
        <a href="/catalog#map">Смотреть карту <span aria-hidden="true">↗</span></a>
      </div>
      {(constructionCount > 0 || developerCount > 0) && (
        <dl class="hero__stats" aria-label="Данные каталога">
          {constructionCount > 0 && <div><dt>{constructionCount}</dt><dd>конструкций опубликовано</dd></div>}
          {developerCount > 0 && <div><dt>{developerCount}</dt><dd>владельцев инвентаря</dd></div>}
        </dl>
      )}
    </div>

    <div class="hero__visual">
      <img
        src={heroImage}
        alt="Сити-формат NOESIS на городской улице"
        fetchpriority="high"
        decoding="async"
      />
      <div class="hero__visual-meta">
        <span>СИТИ-ФОРМАТ</span>
        <p>Грозный · наружная реклама</p>
        <a href="/catalog">Открыть каталог ↗</a>
      </div>
      <span class="hero__coordinates">43.318° N<br />45.698° E</span>
    </div>
  </div>

  <div class="hero__search-wrap container">
    <form class="hero__search" action="/catalog" method="get" data-quick-search>
      <div class="hero__search-heading">
        <span>Быстрый подбор</span>
        <strong>Задайте основные параметры</strong>
      </div>
      <label>
        <span>Начало</span>
        <input type="date" name="from" data-default-from />
      </label>
      <label>
        <span>Окончание</span>
        <input type="date" name="to" data-default-to />
      </label>
      <label>
        <span>Формат</span>
        <select name="format">
          <option value="">Любой формат</option>
          {formats.map((option) => <option value={option.value}>{option.label}</option>)}
        </select>
      </label>
      <label>
        <span>Район</span>
        <select name="district">
          <option value="">Весь Грозный</option>
          {districts.map((district) => <option value={district}>{district}</option>)}
        </select>
      </label>
      <button type="submit">Найти варианты <span aria-hidden="true">→</span></button>
    </form>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: clamp(20px, 3vw, 46px) 0 0;
    background: var(--paper);
    border-bottom: 1px solid var(--line);
  }
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(340px, 0.82fr) minmax(460px, 1.18fr);
    align-items: stretch;
    gap: clamp(22px, 3.5vw, 48px);
  }
  .hero__content { display: flex; min-width: 0; flex-direction: column; padding: clamp(22px, 3vw, 42px) 0; }
  .hero__eyebrow {
    margin: 0 0 18px;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  .hero h1 {
    max-width: 760px;
    margin: 0;
    font-size: clamp(44px, 5.4vw, 78px);
    font-weight: 720;
    letter-spacing: -0.075em;
    line-height: 0.88;
  }
  .hero h1 em { display: block; color: var(--accent); font-style: normal; }
  .hero__lead { max-width: 600px; margin: 20px 0 0; color: var(--muted); font-size: clamp(14px, 1.1vw, 16px); }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 24px; }
  .hero__actions a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 0 14px;
    border: 1px solid var(--ink);
    border-radius: 10px;
    font-size: 13px;
    font-weight: 750;
  }
  .hero__actions a:first-child { color: #fff; background: var(--accent); border-color: var(--accent); }
  .hero__actions a:first-child:hover { background: var(--accent-hover); }
  .hero__actions a:last-child:hover { color: #fff; background: var(--ink); }
  .hero__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 18px 28px;
    margin: auto 0 0;
    padding-top: 32px;
  }
  .hero__stats div { display: grid; grid-template-columns: auto minmax(100px, 150px); align-items: center; gap: 12px; }
  .hero__stats dt { color: var(--accent); font-family: var(--font-mono); font-size: 28px; font-weight: 600; }
  .hero__stats dd { margin: 0; color: var(--muted); font-size: 11px; line-height: 1.35; }

  .hero__visual { position: relative; min-height: 500px; overflow: hidden; background: var(--surface); border-radius: var(--radius-lg); }
  .hero__visual > img { width: 100%; height: 100%; object-fit: cover; }
  .hero__visual::after { position: absolute; inset: 0; background: linear-gradient(180deg, transparent 50%, rgba(15, 15, 14, 0.68)); content: ""; pointer-events: none; }
  .hero__visual-fallback { display: grid; width: 100%; height: 100%; place-items: center; color: var(--muted); font-family: var(--font-mono); }
  .hero__visual-meta {
    position: absolute;
    z-index: 2;
    right: 20px;
    bottom: 20px;
    left: 20px;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: end;
    gap: 18px;
    color: #fff;
  }
  .hero__visual-meta span { font-family: var(--font-mono); font-size: 11px; }
  .hero__visual-meta p { margin: 0; font-size: 12px; }
  .hero__visual-meta a { font-size: 11px; font-weight: 700; }
  .hero__coordinates {
    position: absolute;
    z-index: 2;
    top: 20px;
    right: 20px;
    padding: 9px 10px;
    color: #fff;
    background: rgba(25, 25, 24, 0.78);
    border-radius: 8px;
    font-family: var(--font-mono);
    font-size: 9px;
    line-height: 1.5;
  }

  .hero__search-wrap { position: relative; z-index: 3; transform: translateY(50%); }
  .hero__search {
    display: grid;
    grid-template-columns: minmax(200px, 1.2fr) repeat(4, minmax(130px, 0.8fr)) minmax(160px, 0.9fr);
    align-items: end;
    gap: 12px;
    padding: 18px;
    background: #242421;
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: 18px;
    box-shadow: 0 22px 60px rgba(25, 25, 24, 0.22);
  }
  .hero__search-heading { display: grid; align-self: center; gap: 4px; color: #fff; }
  .hero__search-heading span,
  .hero__search label > span { color: rgba(255, 255, 255, 0.55); font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.08em; text-transform: uppercase; }
  .hero__search-heading strong { font-size: 13px; }
  .hero__search label { display: grid; gap: 7px; }
  .hero__search input,
  .hero__search select {
    width: 100%;
    min-width: 0;
    min-height: 48px;
    padding: 0 12px;
    color: var(--ink);
    background: #fff;
    border: 1px solid transparent;
    border-radius: 9px;
    font-size: 12px;
  }
  .hero__search button {
    display: flex;
    min-height: 48px;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 0 14px;
    color: #fff;
    background: var(--accent);
    border-radius: 9px;
    font-size: 12px;
    font-weight: 750;
  }
  .hero__search button:hover { background: var(--accent-hover); }

  @media (max-width: 1180px) {
    .hero__grid { grid-template-columns: 1fr 1fr; }
    .hero__visual { min-height: 460px; }
    .hero__search { grid-template-columns: repeat(3, 1fr); }
    .hero__search-heading { grid-column: span 1; }
  }
  @media (max-width: 860px) {
    .hero { padding-top: 10px; }
    .hero__grid { grid-template-columns: 1fr; }
    .hero__content { padding-bottom: 0; }
    .hero__stats { margin-top: 34px; padding-top: 0; }
    .hero__visual { min-height: min(72vh, 620px); }
    .hero__search-wrap { transform: none; padding-block: 18px; }
    .hero__search { grid-template-columns: repeat(2, 1fr); }
    .hero__search-heading,
    .hero__search button { grid-column: 1 / -1; }
  }
  @media (max-width: 520px) {
    .hero h1 { font-size: clamp(40px, 13vw, 58px); }
    .hero__actions { display: grid; }
    .hero__visual { min-height: 420px; border-radius: 16px; }
    .hero__visual-meta { grid-template-columns: 1fr auto; }
    .hero__visual-meta p { grid-column: 1 / -1; grid-row: 2; }
    .hero__search { grid-template-columns: 1fr; }
    .hero__search-heading,
    .hero__search button { grid-column: 1; }
  }
</style>
