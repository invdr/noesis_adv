---
import type { DocumentCategoryConstructions } from "../../lib/api";
import SectionHeading from "../SectionHeading.astro";
interface Props { categories: DocumentCategoryConstructions[]; }
const { categories } = Astro.props;
---
{categories.length > 0 && (
  <section class="materials" id="materials">
    <div class="container materials__inner">
      <SectionHeading eyebrow="Материалы" title="Файлы для планирования и производства" description="Презентации, технические требования и документы привязаны к реальным конструкциям каталога." tone="light" />
      <div class="materials__list">
        {categories.slice(0, 5).map((category, index) => (
          <a href={`/materials#${category.category.slug}`}>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <strong>{category.category.name}</strong>
            <small>{category.constructions.length} конструкций</small>
            <b aria-hidden="true">↗</b>
          </a>
        ))}
        <a class="materials__all" href="/materials"><strong>Открыть все материалы</strong><b aria-hidden="true">→</b></a>
      </div>
    </div>
  </section>
)}

<style>
  .materials { padding: clamp(80px, 10vw, 140px) 0; color: #fff; background: var(--accent); }
  .materials__inner { display: grid; grid-template-columns: minmax(280px, 0.75fr) minmax(480px, 1.25fr); gap: clamp(50px, 8vw, 120px); }
  .materials__list { display: grid; align-content: start; }
  .materials__list > a {
    display: grid;
    min-height: 76px;
    grid-template-columns: 44px 1fr auto 30px;
    align-items: center;
    gap: 18px;
    border-top: 1px solid rgba(255, 255, 255, 0.28);
  }
  .materials__list > a:last-child { border-bottom: 1px solid rgba(255, 255, 255, 0.28); }
  .materials__list span,
  .materials__list small { color: rgba(255, 255, 255, 0.58); font-family: var(--font-mono); font-size: 9px; }
  .materials__list strong { font-size: 15px; }
  .materials__list b { text-align: right; font-size: 18px; }
  .materials__list > a:hover strong { text-decoration: underline; text-underline-offset: 4px; }
  .materials__all { grid-template-columns: 44px 1fr 30px !important; }
  @media (max-width: 900px) { .materials__inner { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .materials__list > a { grid-template-columns: 30px 1fr 24px; } .materials__list small { display: none; } }
</style>
