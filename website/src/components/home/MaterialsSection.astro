---
import type { DocumentCategoryConstructions } from "../../lib/api";
import SectionHeading from "../SectionHeading.astro";
interface Props { categories: DocumentCategoryConstructions[]; eyebrow?: string; title?: string; }
const {
  categories,
  eyebrow = "Материалы",
  title = "Файлы для планирования и производства",
} = Astro.props;
---
{categories.length > 0 && (
  <section class="materials" id="materials">
    <div class="container materials__inner">
      <SectionHeading eyebrow={eyebrow} title={title} description="Презентации, технические требования и документы привязаны к реальным конструкциям каталога." />
      <div class="materials__list">
        {categories.slice(0, 5).map((category, index) => (
          <a href={`/materials#${category.category.slug}`}>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <strong>{category.category.name}</strong>
            <small>{category.constructions.length} конструкций</small>
            <b aria-hidden="true">↗</b>
          </a>
        ))}
        <a class="materials__all" href="/materials"><strong>Открыть все материалы</strong><b aria-hidden="true">→</b></a>
      </div>
    </div>
  </section>
)}

<style>
  .materials { padding: clamp(56px, 7vw, 92px) 0; background: var(--canvas); }
  .materials__inner { display: grid; grid-template-columns: minmax(280px, 0.75fr) minmax(480px, 1.25fr); gap: clamp(34px, 5vw, 72px); }
  .materials__list { display: grid; align-content: start; }
  .materials__list > a {
    display: grid;
    min-height: 60px;
    grid-template-columns: 44px 1fr auto 30px;
    align-items: center;
    gap: 18px;
    color: var(--ink);
    border-top: 1px solid var(--line);
  }
  .materials__list > a:last-child { border-bottom: 1px solid var(--line); }
  .materials__list span { color: var(--accent); font-family: var(--font-mono); font-size: 12px; font-weight: 600; }
  .materials__list small { color: var(--muted); font-family: var(--font-mono); font-size: 11px; }
  .materials__list strong { font-size: 16px; font-weight: 600; }
  .materials__list b { text-align: right; color: var(--muted); font-size: 18px; }
  .materials__list > a:hover strong { color: var(--accent); }
  .materials__list > a:hover b { color: var(--accent); }
  .materials__all { grid-template-columns: 44px 1fr 30px !important; }
  .materials__all strong { color: var(--accent); }
  @media (max-width: 900px) { .materials__inner { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .materials__list > a { grid-template-columns: 30px 1fr 24px; } .materials__list small { display: none; } }
</style>
