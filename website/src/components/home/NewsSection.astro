---
import type { NewsView } from "../../lib/api";
import NewsCard from "../NewsCard.astro";
import SectionHeading from "../SectionHeading.astro";
interface Props { items: NewsView[]; eyebrow?: string; title?: string; allCta?: string; }
const {
  items,
  eyebrow = "Кейсы и новости",
  title = "Город, кампании и практика размещения",
  allCta = "Все материалы",
} = Astro.props;
---
{items.length > 0 && (
  <section class="news" id="cases">
    <div class="container">
      <div class="news__heading">
        <SectionHeading eyebrow={eyebrow} title={title} description="Публикации из NOESIS |ad: новые позиции, примеры кампаний и полезные материалы для рекламодателей." />
        <a href="/news">{allCta} →</a>
      </div>
      <div class="news__grid">{items.slice(0, 3).map((item) => <NewsCard item={item} />)}</div>
    </div>
  </section>
)}

<style>
  .news { padding: clamp(60px, 8vw, 108px) 0; }
  .news__heading { display: flex; align-items: end; justify-content: space-between; gap: 30px; }
  .news__heading > a { flex: 0 0 auto; padding-bottom: 8px; color: var(--accent); font-size: 12px; font-weight: 750; }
  .news__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; margin-top: 32px; }
  @media (max-width: 900px) { .news__grid { grid-template-columns: repeat(2, 1fr); } .news__grid > :last-child { display: none; } }
  @media (max-width: 620px) { .news__heading { align-items: start; flex-direction: column; } .news__grid { grid-template-columns: 1fr; } .news__grid > :last-child { display: block; } }
</style>
