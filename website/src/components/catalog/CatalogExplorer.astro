---
import { CONSTRUCTION_FORMAT_LABEL } from "@noesis/contracts";
import type { CatalogItem } from "../../lib/api";
import { jsonForHtml } from "../../lib/json";
import ConstructionCard from "../ConstructionCard.astro";
import MapCanvas from "../MapCanvas.astro";

interface Props {
  items: CatalogItem[];
  mapApiKey: string;
}
const { items, mapApiKey } = Astro.props;
const formats = Array.from(new Set(items.map((item) => item.format))).map((value) => ({ value, label: CONSTRUCTION_FORMAT_LABEL[value] }));
const districts = Array.from(new Set(items.map((item) => item.district).filter((value): value is string => Boolean(value)))).sort((a, b) => a.localeCompare(b, "ru"));
const data = jsonForHtml({ items, map: { apiKey: mapApiKey, center: [43.318, 45.698], zoom: 12 } });
---
<section class="catalog-page">
  <div class="catalog-page__intro container">
    <div>
      <p>Каталог городского инвентаря</p>
      <h1>Конструкции <em>на карте Грозного</em></h1>
    </div>
    <p>Сравнивайте адреса, форматы и стороны. Доступность обновляется по выбранному периоду из действующих бронирований.</p>
  </div>

  <form class="filters container" data-catalog-filters>
    <div class="filters__main">
      <label><span>Начало периода</span><input type="date" name="from" /></label>
      <label><span>Окончание периода</span><input type="date" name="to" /></label>
      <label>
        <span>Формат</span>
        <select name="format"><option value="">Все форматы</option>{formats.map((item) => <option value={item.value}>{item.label}</option>)}</select>
      </label>
      <label>
        <span>Район</span>
        <select name="district"><option value="">Все районы</option>{districts.map((item) => <option value={item}>{item}</option>)}</select>
      </label>
      <label>
        <span>Подсветка</span>
        <select name="lighting">
          <option value="">Любая</option>
          <option value="internal">Внутренняя</option>
          <option value="external">Внешняя</option>
          <option value="none">Без подсветки</option>
        </select>
      </label>
      <label>
        <span>Количество сторон</span>
        <select name="sideCount">
          <option value="">Любое</option>
          <option value="1">1 сторона</option>
          <option value="2">2 стороны</option>
          <option value="3">3 стороны</option>
        </select>
      </label>
      <label><span>Цена от, ₽/мес</span><input type="number" name="priceFrom" min="0" step="1000" inputmode="numeric" placeholder="0" /></label>
      <label><span>Цена до, ₽/мес</span><input type="number" name="priceTo" min="0" step="1000" inputmode="numeric" placeholder="Без лимита" /></label>
    </div>
    <div class="filters__footer">
      <label class="filters__free">
        <input type="checkbox" name="onlyFree" disabled />
        <span>Только со свободной стороной</span>
      </label>
      <div class="filters__chips" data-filter-chips aria-label="Активные фильтры"></div>
      <button type="button" class="filters__reset" data-filter-reset>Сбросить всё</button>
    </div>
  </form>

  <div class="catalog-page__toolbar container">
    <p data-catalog-status role="status" aria-live="polite">Найдено: {items.length}</p>
    <div class="catalog-page__switch" aria-label="Режим отображения">
      <button type="button" data-view="list" aria-pressed="true">Список</button>
      <button type="button" data-view="map" aria-pressed="false">Карта</button>
    </div>
  </div>

  <div class="catalog-page__layout container">
    <div class="catalog-page__list" data-catalog-list>
      <div class="catalog-page__loading" data-catalog-loading hidden>
        <span></span><p>Проверяем доступность по датам…</p>
      </div>
      <div class="catalog-page__cards" data-catalog-cards>
        {items.map((item) => <ConstructionCard item={item} mapAction />)}
      </div>
      <div class="catalog-page__empty" data-catalog-empty hidden>
        <span aria-hidden="true">∅</span>
        <h2>По этим параметрам ничего не найдено</h2>
        <p>Удалите один из фильтров или сбросьте параметры, чтобы увидеть все конструкции.</p>
        <button type="button" data-filter-reset>Показать весь каталог</button>
      </div>
      {items.length === 0 && (
        <div class="catalog-page__empty">
          <span aria-hidden="true">∅</span>
          <h2>Каталог готовится к публикации</h2>
          <p>Опубликованные конструкции появятся здесь автоматически.</p>
        </div>
      )}
    </div>

    <aside class="catalog-page__map" id="map" data-catalog-map aria-label="Карта результатов">
      <div class="catalog-page__map-head">
        <div><span>География выдачи</span><strong data-map-count>{items.filter((item) => item.lat != null && item.lng != null).length} точек</strong></div>
        <div aria-label="Статусы маркеров"><span><i></i> Свободно</span><span><i></i> Частично</span><span><i></i> Занято</span></div>
      </div>
      <MapCanvas id="catalog-map" />
      <p class="catalog-page__map-note" data-map-note>Выберите карточку или маркер — связанный объект будет выделен.</p>
    </aside>
  </div>
  <script is:inline id="catalog-data" type="application/json" set:html={data}></script>
</section>

<style>
  .catalog-page { padding: clamp(44px, 6vw, 88px) 0 clamp(80px, 10vw, 140px); }
  .catalog-page__intro { display: grid; grid-template-columns: 1.25fr 0.75fr; align-items: end; gap: 40px; }
  .catalog-page__intro > div > p {
    margin: 0 0 18px;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .catalog-page__intro h1 { margin: 0; font-family: var(--font-display); font-size: clamp(38px, 5vw, 60px); font-weight: 600; letter-spacing: 0.01em; line-height: 1.02; text-transform: uppercase; }
  .catalog-page__intro h1 em { color: var(--accent); font-style: normal; }
  .catalog-page__intro > p { max-width: 560px; margin: 0; color: var(--muted); font-size: 16px; }

  .filters { margin-top: 40px; padding: 16px; background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius-md); }
  .filters__main { display: grid; grid-template-columns: repeat(8, minmax(110px, 1fr)); gap: 10px; }
  .filters label { display: grid; gap: 7px; min-width: 0; }
  .filters label > span { color: var(--muted); font-family: var(--font-mono); font-size: 9px; font-weight: 500; letter-spacing: 0.06em; text-transform: uppercase; }
  .filters input:not([type="checkbox"]),
  .filters select {
    width: 100%;
    min-width: 0;
    min-height: 44px;
    padding: 0 10px;
    color: var(--ink);
    background: var(--canvas);
    border: 1.5px solid var(--line);
    border-radius: var(--radius-sm);
    font-size: 13px;
    font-weight: 500;
  }
  .filters input:focus,
  .filters select:focus { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(139, 0, 0, 0.1); outline: none; }
  .filters__footer { display: flex; min-height: 54px; align-items: center; gap: 16px; margin-top: 14px; padding-top: 14px; border-top: 1px solid var(--line); }
  .filters__free { display: flex !important; flex: 0 0 auto; grid-template-columns: 20px 1fr; align-items: center; gap: 9px !important; cursor: pointer; }
  .filters__free input { width: 19px; height: 19px; accent-color: var(--accent); }
  .filters__free span { color: var(--ink) !important; font-family: var(--font-sans) !important; font-size: 11px !important; letter-spacing: 0 !important; text-transform: none !important; }
  .filters__free:has(input:disabled) { opacity: 0.5; cursor: not-allowed; }
  .filters__chips { display: flex; min-width: 0; flex: 1; flex-wrap: wrap; gap: 7px; }
  :global(.catalog-chip) {
    display: inline-flex;
    min-height: 32px;
    align-items: center;
    gap: 8px;
    padding: 0 10px;
    color: var(--accent);
    background: var(--accent-soft);
    border-radius: 999px;
    font-size: 10px;
    font-weight: 650;
  }
  :global(.catalog-chip span) { font-size: 15px; line-height: 1; }
  .filters__reset { min-height: 40px; flex: 0 0 auto; padding: 0 12px; color: var(--muted); background: transparent; font-size: 11px; font-weight: 700; }
  .filters__reset:hover { color: var(--accent); }

  .catalog-page__toolbar { display: flex; min-height: 74px; align-items: center; justify-content: space-between; gap: 18px; }
  .catalog-page__toolbar p { margin: 0; font-family: var(--font-mono); font-size: 11px; }
  .catalog-page__switch { display: none; gap: 0; padding: 0; overflow: hidden; border: 1.5px solid var(--line); border-radius: var(--radius-sm); }
  .catalog-page__switch button { min-width: 84px; min-height: 40px; padding: 0 14px; color: var(--muted); background: var(--paper); font-size: 13px; font-weight: 600; }
  .catalog-page__switch button[aria-pressed="true"] { color: #fbfaf5; background: var(--ink); }

  .catalog-page__layout { display: grid; grid-template-columns: minmax(380px, 0.78fr) minmax(520px, 1.22fr); align-items: start; gap: 20px; }
  .catalog-page__list { position: relative; min-width: 0; }
  .catalog-page__cards { display: grid; grid-template-columns: 1fr; gap: 16px; }
  .catalog-page__loading {
    display: flex;
    min-height: 48px;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
    padding: 0 14px;
    color: var(--muted);
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 10px;
    font-size: 11px;
  }
  .catalog-page__loading span { width: 14px; height: 14px; border: 2px solid var(--line); border-top-color: var(--accent); border-radius: 50%; animation: spin 700ms linear infinite; }
  .catalog-page__loading p { margin: 0; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .catalog-page__empty {
    display: grid;
    min-height: 420px;
    place-content: center;
    padding: 40px;
    text-align: center;
    background: var(--paper);
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius-md);
  }
  .catalog-page__empty > span { color: var(--accent); font-family: var(--font-mono); font-size: 36px; }
  .catalog-page__empty h2 { max-width: 500px; margin: 18px auto 0; font-family: var(--font-display); font-size: clamp(24px, 3vw, 34px); font-weight: 600; letter-spacing: 0.01em; text-transform: uppercase; }
  .catalog-page__empty p { max-width: 480px; margin: 12px auto 0; color: var(--muted); font-size: 14px; }
  .catalog-page__empty button { min-height: 46px; margin: 24px auto 0; padding: 0 20px; color: #fbfaf5; background: var(--accent); border-radius: var(--radius-sm); font-size: 13px; font-weight: 600; }
  .catalog-page__empty button:hover { background: var(--accent-hover); }

  .catalog-page__map { position: sticky; top: calc(var(--header-height) + 16px); min-width: 0; }
  .catalog-page__map-head { display: flex; min-height: 52px; align-items: start; justify-content: space-between; gap: 16px; padding: 0 4px 12px; }
  .catalog-page__map-head > div:first-child { display: grid; gap: 2px; }
  .catalog-page__map-head > div:first-child span { color: var(--muted); font-family: var(--font-mono); font-size: 9px; text-transform: uppercase; }
  .catalog-page__map-head strong { font-size: 12px; }
  .catalog-page__map-head > div:last-child { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 7px 10px; }
  .catalog-page__map-head > div:last-child span { display: inline-flex; align-items: center; gap: 5px; color: var(--muted); font-size: 9px; }
  .catalog-page__map-head i { width: 7px; height: 7px; background: var(--positive); border-radius: 50%; }
  .catalog-page__map-head span:nth-child(2) i { background: var(--warning); }
  .catalog-page__map-head span:nth-child(3) i { background: var(--busy); }
  .catalog-page__map-note { min-height: 22px; margin: 9px 4px 0; color: var(--muted); font-size: 10px; }

  @media (max-width: 1240px) {
    .filters__main { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .catalog-page__layout { grid-template-columns: minmax(340px, 0.85fr) minmax(450px, 1.15fr); }
  }
  @media (max-width: 900px) {
    .catalog-page__intro { grid-template-columns: 1fr; }
    .catalog-page__switch { display: flex; }
    .catalog-page__layout { grid-template-columns: 1fr; }
    .catalog-page__map { position: static; display: none; }
    .catalog-page__layout[data-view="map"] .catalog-page__list { display: none; }
    .catalog-page__layout[data-view="map"] .catalog-page__map { display: block; }
    .catalog-page__layout[data-view="list"] .catalog-page__list { display: block; }
  }
  @media (max-width: 700px) {
    .filters__main { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .filters__footer { align-items: stretch; flex-direction: column; }
    .filters__reset { align-self: flex-start; }
  }
  @media (max-width: 460px) {
    .catalog-page__intro h1 { font-size: 52px; }
    .filters__main { grid-template-columns: 1fr; }
    .catalog-page__toolbar { align-items: start; flex-direction: column; padding-block: 16px; }
    .catalog-page__switch { width: 100%; }
    .catalog-page__switch button { flex: 1; }
    .catalog-page__map-head { align-items: start; flex-direction: column; }
    .catalog-page__map-head > div:last-child { justify-content: flex-start; }
  }
  @media (prefers-reduced-motion: reduce) { .catalog-page__loading span { animation: none; } }
</style>
