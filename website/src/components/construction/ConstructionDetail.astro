---
import type { Asset, Construction, DocumentGroup } from "../../lib/api";
import { documentHref, documentMeta } from "../../lib/api";
import { jsonForHtml } from "../../lib/json";
import LeadForm from "../LeadForm.astro";
import MapCanvas from "../MapCanvas.astro";

interface Props {
  construction: Construction;
  documents: DocumentGroup[];
  mapApiKey: string;
}
const { construction, documents, mapApiKey } = Astro.props;
const firstSide = construction.sides[0];
const cityFormatImage: Asset = { url: "/assets/city-format-noesis-wide-v3.png" };
const visualConstruction = {
  ...construction,
  cover: cityFormatImage,
  images: [cityFormatImage],
  sides: construction.sides.map((side) => ({ ...side, photo: cityFormatImage })),
};
const mainImage = cityFormatImage;
const traffic = firstSide?.trafficPerDay ?? construction.trafficPerDay;
const grp = firstSide?.grp ?? construction.grp;
const initialReach = grp != null
  ? `GRP ${grp}`
  : traffic != null
    ? `${new Intl.NumberFormat("ru-RU").format(traffic)} чел./день`
    : "По запросу";
const formatLabels: Record<string, string> = {
  cityFormat: "Сити-формат",
  billboard: "Щит 3 × 6",
  superSite: "Суперсайт",
  pillar: "Пилон / стела",
  mediaScreen: "Медиаэкран",
  other: "Другое",
};
const lightingLabels: Record<string, string> = { none: "Без подсветки", internal: "Внутренняя", external: "Внешняя" };
const data = jsonForHtml({ construction: visualConstruction, map: { apiKey: mapApiKey, zoom: 16 } });
---
<article class="detail">
  <div class="detail__breadcrumbs container" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/catalog">Каталог</a><span>/</span><span>{construction.code || construction.name}</span>
  </div>

  <section class="detail__hero container">
    <div class="detail__media">
      {mainImage ? (
        <img
          src={mainImage.url}
          srcset={mainImage.renditions?.srcset}
          sizes={mainImage.renditions?.srcset ? "(max-width: 900px) 100vw, 62vw" : undefined}
          alt={`Конструкция ${construction.name}, сторона ${firstSide?.code || "A"}`}
          data-gallery-main
          fetchpriority="high"
          decoding="async"
        />
      ) : (
        <div class="detail__media-fallback" data-gallery-fallback>Фотография готовится к публикации</div>
      )}
      <div class="detail__media-code"><span>{construction.code || "Код уточняется"}</span><span>{construction.lat?.toFixed(4) || "—"}° N · {construction.lng?.toFixed(4) || "—"}° E</span></div>
      {construction.badges.length > 0 && (
        <div class="detail__badges">{construction.badges.map((badge) => <span>{badge.text}</span>)}</div>
      )}
    </div>

    <div class="detail__summary">
      <div class="detail__summary-top">
        <p>{construction.district || "Грозный"} · {formatLabels[construction.format]}</p>
        <h1>{construction.name}</h1>
        <address>{construction.address || "Адрес уточняется"}</address>
      </div>

      <div class="detail__side-picker" aria-label="Выбор стороны">
        <span>Сторона конструкции</span>
        <div>
          {construction.sides.map((side, index) => (
            <button type="button" data-side-button={side.code} aria-pressed={index === 0 ? "true" : "false"}>
              <b>{side.code}</b>
              <small data-side-status={side.code}>Проверяем даты</small>
            </button>
          ))}
        </div>
      </div>

      <div class="detail__side-data">
        <dl>
          <div><dt>Направление обзора</dt><dd data-side-description>{firstSide?.description || "Описание направления уточняется"}</dd></div>
          <div><dt>Трафик / охват</dt><dd data-side-reach>{initialReach}</dd></div>
          <div><dt>Стоимость</dt><dd data-side-price>{firstSide?.priceLabel || construction.priceLabel}</dd></div>
        </dl>
      </div>

      <div class="detail__period">
        <span>Период размещения</span>
        <div>
          <label><span>С</span><input type="date" data-detail-from /></label>
          <label><span>По</span><input type="date" data-detail-to /></label>
        </div>
        <p data-detail-status role="status" aria-live="polite">Проверяем доступность…</p>
      </div>

      <button class="detail__add" type="button" data-detail-add>
        <span data-detail-add-label>Добавить сторону в подборку</span><span aria-hidden="true">+</span>
      </button>
      {construction.sides.length > 1 && (
        <button class="detail__add detail__add--all" type="button" data-detail-add-all>
          <span data-detail-add-all-label>Все стороны в подборку</span><span aria-hidden="true">⧉</span>
        </button>
      )}
      <p class="detail__disclaimer">Добавление в подборку не бронирует поверхность.</p>
    </div>
  </section>

  {visualConstruction.images.length > 1 && (
    <section class="detail__gallery container" aria-label="Фотогалерея">
      <div class="detail__gallery-head"><span>Фотогалерея</span><strong>{visualConstruction.images.length} фото</strong></div>
      <div class="detail__gallery-strip">
        {visualConstruction.images.map((image, index) => (
          <button type="button" data-gallery-index={index} aria-label={`Показать фотографию ${index + 1}`} aria-pressed={index === 0 ? "true" : "false"}>
            <img src={image.renditions?.thumbnailUrl || image.url} alt="" loading="lazy" decoding="async" />
          </button>
        ))}
      </div>
    </section>
  )}

  <section class="detail__facts">
    <div class="container detail__facts-grid">
      <div class="detail__description">
        <p>О локации</p>
        <h2>{construction.description || "Городская рекламная конструкция с адресной привязкой и выбором стороны."}</h2>
      </div>
      <dl>
        <div><dt>Код конструкции</dt><dd>{construction.code || "Не указан"}</dd></div>
        <div><dt>Формат</dt><dd>{formatLabels[construction.format]}</dd></div>
        <div><dt>Размер</dt><dd>{construction.size || "По запросу"}</dd></div>
        <div><dt>Сторон</dt><dd>{construction.sideCount} · {construction.sides.map((side) => side.code).join(" / ")}</dd></div>
        <div><dt>Подсветка</dt><dd>{lightingLabels[construction.lighting]}</dd></div>
        <div><dt>Район</dt><dd>{construction.district || "Не указан"}</dd></div>
      </dl>
    </div>
  </section>

  <section class="detail__availability container">
    <div class="detail__availability-head">
      <div><p>Календарь занятости</p><h2>Свободные и занятые даты</h2></div>
      <div class="detail__legend" aria-label="Обозначения календаря">
        <span><i></i> Свободно</span><span><i></i> Занято</span><span><i></i> Сегодня</span>
      </div>
    </div>
    <div class="detail__calendar-shell">
      <div class="detail__calendar-side">
        <span>Показана сторона</span>
        <strong data-calendar-side>{firstSide?.code || "A"}</strong>
        <p data-calendar-note>Данные загружаются по выбранному периоду.</p>
      </div>
      <div class="detail__calendar" data-availability-calendar aria-live="polite"></div>
    </div>
  </section>

  <section class="detail__location container">
    <div class="detail__location-copy">
      <p>Локация</p>
      <h2>{construction.address || "Грозный"}</h2>
      <dl>
        <div><dt>Широта</dt><dd>{construction.lat?.toFixed(6) || "Не указана"}</dd></div>
        <div><dt>Долгота</dt><dd>{construction.lng?.toFixed(6) || "Не указана"}</dd></div>
      </dl>
      {construction.lat != null && construction.lng != null && (
        <a href={`https://yandex.ru/maps/?pt=${construction.lng},${construction.lat}&z=17&l=map`} target="_blank" rel="noopener noreferrer">Построить маршрут в Яндекс.Картах ↗</a>
      )}
    </div>
    <MapCanvas id="construction-map" compact />
  </section>

  {documents.length > 0 && (
    <section class="detail__documents" id="materials">
      <div class="container">
        <div class="detail__documents-head"><p>Материалы</p><h2>Документы по конструкции</h2></div>
        <div class="detail__document-groups">
          {documents.map((group) => (
            <section>
              <h3>{group.category.name}</h3>
              <div>
                {group.documents.map((document) => (
                  <a href={documentHref(document)} target="_blank" rel="noopener noreferrer">
                    <span>{document.name}</span><small>{documentMeta(document)}</small><b aria-hidden="true">↗</b>
                  </a>
                ))}
              </div>
            </section>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="detail__form container">
    <LeadForm
      title={`Уточнить условия по ${construction.code || construction.name}`}
      description="Выбранные сторона и период уже добавлены в сообщение. Менеджер проверит бронь и свяжется с вами."
      source="project"
      variant="dark"
      constructionId={construction.id}
      includeShortlist={false}
    />
  </section>
  <script is:inline id="construction-data" type="application/json" set:html={data}></script>
</article>

<style>
  .detail { padding: 20px 0 clamp(80px, 10vw, 150px); }
  .detail__breadcrumbs { display: flex; min-height: 52px; align-items: center; gap: 9px; overflow: hidden; color: var(--muted); font-family: var(--font-mono); font-size: 11px; white-space: nowrap; }
  .detail__breadcrumbs a:hover { color: var(--accent); }
  .detail__breadcrumbs > span:last-child { overflow: hidden; text-overflow: ellipsis; }
  .detail__hero { display: grid; grid-template-columns: minmax(500px, 1.25fr) minmax(360px, 0.75fr); min-height: 600px; gap: 20px; }
  .detail__media { position: relative; min-width: 0; min-height: 510px; overflow: hidden; background: var(--surface); border-radius: var(--radius-lg); }
  .detail__media > img { width: 100%; height: 100%; object-fit: cover; }
  .detail__media::after { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(20, 20, 18, 0.24), transparent 38%, rgba(20, 20, 18, 0.42)); content: ""; pointer-events: none; }
  .detail__media-fallback { display: grid; width: 100%; height: 100%; min-height: 510px; place-items: center; color: var(--muted); font-family: var(--font-mono); font-size: 11px; }
  .detail__media-code { position: absolute; z-index: 2; right: 18px; bottom: 18px; left: 18px; display: flex; justify-content: space-between; gap: 16px; color: #fff; font-family: var(--font-mono); font-size: 11px; }
  .detail__badges { position: absolute; z-index: 2; top: 18px; left: 18px; display: flex; flex-wrap: wrap; gap: 7px; }
  .detail__badges span { padding: 6px 10px; color: #fbfaf5; background: var(--accent); border-radius: var(--radius-sm); font-family: var(--font-mono); font-size: 10px; }

  .detail__summary { display: flex; min-width: 0; flex-direction: column; padding: clamp(18px, 2.4vw, 30px); background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius-lg); }
  .detail__summary-top > p,
  .detail__side-picker > span,
  .detail__period > span { margin: 0; color: var(--accent); font-family: var(--font-mono); font-size: 11px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; }
  .detail__summary h1 { margin: 12px 0 0; font-family: var(--font-display); font-size: clamp(28px, 3.4vw, 42px); font-weight: 600; letter-spacing: 0.01em; line-height: 1.04; text-transform: uppercase; }
  .detail__summary address { margin-top: 14px; color: var(--muted); font-size: 14px; font-style: normal; }
  .detail__side-picker { margin-top: 24px; padding-top: 20px; border-top: 1px solid var(--line); }
  .detail__side-picker > div { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; margin-top: 10px; }
  .detail__side-picker button { display: grid; min-height: 54px; align-content: center; gap: 3px; padding: 7px 12px; color: var(--ink); background: var(--paper); border: 1.5px solid var(--line); border-radius: var(--radius-sm); text-align: left; }
  .detail__side-picker button[aria-pressed="true"] { color: #fbfaf5; background: var(--ink); border-color: var(--ink); }
  .detail__side-picker b { font-family: var(--font-mono); font-size: 16px; }
  .detail__side-picker small { overflow: hidden; color: var(--muted); font-size: 11px; text-overflow: ellipsis; white-space: nowrap; }
  .detail__side-picker button[aria-pressed="true"] small { color: rgba(251, 250, 245, 0.72); }
  .detail__side-data { margin-top: 18px; }
  .detail__side-data dl { display: grid; gap: 10px; margin: 0; }
  .detail__side-data dl > div { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: 12px; padding-bottom: 10px; border-bottom: 1px solid var(--line); }
  .detail__side-data dt { color: var(--muted); font-size: 11px; }
  .detail__side-data dd { margin: 0; text-align: right; font-size: 11px; font-weight: 650; }
  .detail__period { margin-top: auto; padding-top: 24px; }
  .detail__period > div { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 10px; }
  .detail__period label { display: grid; gap: 5px; }
  .detail__period label span { color: var(--muted); font-size: 8px; }
  .detail__period input { width: 100%; min-width: 0; min-height: 46px; padding: 0 10px; color: var(--ink); background: var(--canvas); border: 1.5px solid var(--line); border-radius: var(--radius-sm); font-size: 13px; }
  .detail__period input:focus { border-color: var(--accent); outline: none; }
  .detail__period > p { min-height: 20px; margin: 9px 0 0; color: var(--muted); font-size: 11px; }
  .detail__period > p[data-state="free"] { color: var(--positive); }
  .detail__period > p[data-state="partial"] { color: var(--warning); }
  .detail__period > p[data-state="occupied"] { color: var(--busy); }
  .detail__add { display: flex; min-height: 52px; align-items: center; justify-content: space-between; gap: 16px; margin-top: 12px; padding: 0 18px; color: #fbfaf5; background: var(--accent); border-radius: var(--radius-sm); font-size: 14px; font-weight: 600; }
  .detail__add:hover:not(:disabled) { background: var(--accent-hover); }
  .detail__add.is-added { color: var(--accent); background: var(--accent-soft); }
  .detail__add:disabled { opacity: 0.55; }
  .detail__add--all { margin-top: 8px; color: var(--accent); background: transparent; border: 1.5px solid var(--accent); }
  .detail__add--all:hover:not(:disabled) { color: #fbfaf5; background: var(--accent); }
  .detail__add--all.is-added { color: var(--accent); background: var(--accent-soft); border-color: var(--accent-soft); }
  .detail__disclaimer { margin: 8px 0 0; color: var(--muted); font-size: 11px; }

  .detail__gallery { margin-top: 20px; }
  .detail__gallery-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; color: var(--muted); font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; }
  .detail__gallery-strip { display: grid; grid-auto-columns: minmax(150px, 230px); grid-auto-flow: column; gap: 10px; overflow-x: auto; padding-bottom: 8px; scroll-snap-type: x mandatory; }
  .detail__gallery-strip button { min-height: 140px; padding: 0; overflow: hidden; background: var(--surface); border: 2px solid transparent; border-radius: 12px; scroll-snap-align: start; }
  .detail__gallery-strip button[aria-pressed="true"] { border-color: var(--accent); }
  .detail__gallery-strip img { width: 100%; height: 100%; object-fit: cover; }

  .detail__facts { margin-top: clamp(60px, 7.5vw, 104px); padding: clamp(52px, 6.5vw, 92px) 0; color: #fbfaf5; background: var(--dark); }
  .detail__facts-grid { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: clamp(36px, 5vw, 80px); }
  .detail__description > p,
  .detail__documents-head > p,
  .detail__location-copy > p,
  .detail__availability-head p { margin: 0 0 18px; color: var(--accent); font-family: var(--font-mono); font-size: 11px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; }
  .detail__description h2 { margin: 0; font-family: var(--font-display); font-size: clamp(24px, 3.2vw, 40px); font-weight: 600; letter-spacing: 0.01em; line-height: 1.08; text-transform: uppercase; }
  .detail__facts dl { display: grid; margin: 0; }
  .detail__facts dl > div { display: flex; min-height: 48px; align-items: center; justify-content: space-between; gap: 20px; border-top: 1px solid var(--dark-line); }
  .detail__facts dl > div:last-child { border-bottom: 1px solid var(--dark-line); }
  .detail__facts dt { color: var(--muted); font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.04em; text-transform: uppercase; }
  .detail__facts dd { margin: 0; text-align: right; font-family: var(--font-mono); font-size: 13px; font-weight: 500; }

  .detail__availability { padding-top: clamp(60px, 7.5vw, 104px); }
  .detail__availability-head { display: flex; align-items: end; justify-content: space-between; gap: 30px; }
  .detail__availability-head h2,
  .detail__location-copy h2,
  .detail__documents-head h2 { margin: 0; font-family: var(--font-display); font-size: clamp(32px, 4.6vw, 52px); font-weight: 600; letter-spacing: 0.01em; line-height: 1.03; text-transform: uppercase; }
  .detail__legend { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 10px 14px; }
  .detail__legend span { display: inline-flex; align-items: center; gap: 6px; color: var(--muted); font-size: 11px; }
  .detail__legend i { width: 9px; height: 9px; background: var(--positive-soft); border: 1px solid var(--positive); border-radius: 3px; }
  .detail__legend span:nth-child(2) i { background: var(--busy-soft); border-color: var(--busy); }
  .detail__legend span:nth-child(3) i { background: var(--ink); border-color: var(--ink); border-radius: 50%; }
  .detail__calendar-shell { display: grid; grid-template-columns: 200px 1fr; gap: 28px; margin-top: 38px; padding: 26px; background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius-md); }
  .detail__calendar-side { padding-right: 24px; border-right: 1px solid var(--line); }
  .detail__calendar-side > span { color: var(--muted); font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; }
  .detail__calendar-side > strong { display: block; margin-top: 10px; color: var(--accent); font-family: var(--font-mono); font-size: 44px; line-height: 1; }
  .detail__calendar-side p { margin: 20px 0 0; color: var(--muted); font-size: 11px; }
  .detail__calendar { display: grid; grid-template-columns: repeat(2, minmax(250px, 1fr)); gap: 30px; min-width: 0; }
  :global(.availability-month) { min-width: 0; }
  :global(.availability-month h3) { margin: 0 0 12px; font-size: 15px; text-transform: capitalize; }
  :global(.availability-weekdays),
  :global(.availability-days) { display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px; }
  :global(.availability-weekdays span) { padding: 4px 0; color: var(--muted); font-family: var(--font-mono); font-size: 10px; text-align: center; }
  :global(.availability-day) { display: grid; min-width: 28px; min-height: 30px; place-items: center; padding: 0; color: var(--ink); background: var(--positive-soft); border: 1px solid transparent; border-radius: 6px; font-family: var(--font-mono); font-size: 11px; }
  :global(.availability-day[data-state="busy"]) { color: var(--busy); background: var(--busy-soft); text-decoration: line-through; }
  :global(.availability-day[data-today="true"]) { color: #fbfaf5; background: var(--ink); border-radius: 50%; }
  :global(.availability-day[data-outside="true"]) { visibility: hidden; }
  :global(.availability-message) { grid-column: 1 / -1; margin: 0; padding: 28px; color: var(--muted); background: var(--canvas); border-radius: 12px; font-size: 12px; text-align: center; }

  .detail__location { display: grid; grid-template-columns: minmax(300px, 0.65fr) minmax(500px, 1.35fr); align-items: stretch; gap: 22px; padding-top: clamp(60px, 7.5vw, 104px); }
  .detail__location-copy { display: flex; flex-direction: column; padding: clamp(26px, 4vw, 50px); background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius-lg); }
  .detail__location-copy dl { display: grid; gap: 10px; margin: 38px 0 0; }
  .detail__location-copy dl > div { display: flex; justify-content: space-between; gap: 20px; padding-top: 10px; border-top: 1px solid var(--line); }
  .detail__location-copy dt { color: var(--muted); font-size: 10px; }
  .detail__location-copy dd { margin: 0; font-family: var(--font-mono); font-size: 10px; }
  .detail__location-copy a { display: flex; min-height: 48px; align-items: center; justify-content: center; margin-top: auto; color: #fbfaf5; background: var(--accent); border-radius: var(--radius-sm); font-size: 13px; font-weight: 600; }
  .detail__location-copy a:hover { background: var(--accent-hover); }

  .detail__documents { margin-top: clamp(60px, 7.5vw, 104px); padding: clamp(52px, 6.5vw, 92px) 0; background: var(--paper); }
  .detail__documents-head { display: grid; grid-template-columns: 0.4fr 1fr; align-items: end; gap: 30px; }
  .detail__document-groups { display: grid; gap: 28px; margin-top: 48px; }
  .detail__document-groups section { display: grid; grid-template-columns: 0.4fr 1fr; gap: 30px; }
  .detail__document-groups h3 { margin: 0; font-size: 18px; font-weight: 600; }
  .detail__document-groups section > div { display: grid; }
  .detail__document-groups a { display: grid; min-height: 64px; grid-template-columns: 1fr auto 24px; align-items: center; gap: 16px; border-top: 1px solid var(--line); }
  .detail__document-groups a:last-child { border-bottom: 1px solid var(--line); }
  .detail__document-groups a > span { font-size: 13px; font-weight: 650; }
  .detail__document-groups small { color: var(--muted); font-family: var(--font-mono); font-size: 11px; }
  .detail__document-groups a:hover > span { color: var(--accent); }
  .detail__form { padding-top: clamp(60px, 7.5vw, 104px); }

  @media (max-width: 1050px) {
    .detail__hero { grid-template-columns: 1fr; }
    .detail__media { min-height: min(72vh, 700px); }
    .detail__summary { min-height: 680px; }
    .detail__facts-grid,
    .detail__location { grid-template-columns: 1fr; }
    .detail__calendar { grid-template-columns: 1fr; }
  }
  @media (max-width: 720px) {
    .detail { padding-top: 0; }
    .detail__hero { width: 100%; gap: 10px; }
    .detail__media,
    .detail__summary { border-radius: 0; border-inline: 0; }
    .detail__media { min-height: 56vh; }
    .detail__summary { min-height: 0; }
    .detail__facts-grid { gap: 44px; }
    .detail__availability-head { align-items: start; flex-direction: column; }
    .detail__legend { justify-content: flex-start; }
