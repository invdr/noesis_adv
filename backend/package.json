{
  "name": "@gsk-tower/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun run prisma:generate && tsc --noEmit",
    "typecheck": "bun run prisma:generate && tsc --noEmit",
    "test": "bun test",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "db:seed": "bun run prisma/seed.ts"
  },
  "dependencies": {
    "@gsk-tower/contracts": "workspace:*",
    "@prisma/client": "^6.3.1",
    "file-type": "^22.0.1",
    "hono": "^4.7.0",
    "sharp": "^0.35.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "prisma": "^6.3.1",
    "typescript": "^5.7.3"
  }
}
