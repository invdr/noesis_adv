# Подключение к Postgres (локально — из docker-compose, порт 54329)
DATABASE_URL="postgresql://superuser:superpassword@localhost:54329/gsk_tower?schema=public"

# HTTP
PORT=3000

# Разрешённые источники для CORS (через запятую): лендинг и CRM
CORS_ORIGINS="http://localhost:4321,http://localhost:5173"

# Сессии CRM
# Время жизни сессии в часах (продлевается при активности)
SESSION_TTL_HOURS=12
# Cookie сессии помечается Secure. Если не задано — включается автоматически
# при NODE_ENV=production. Локально по HTTP оставляем false.
COOKIE_SECURE=false

# Первый администратор для сид-команды (bun run --cwd backend db:seed).
# Пароль временный — система потребует сменить его при первом входе.
ADMIN_EMAIL="admin@gsktower.com"
ADMIN_PASSWORD="change-me-please"

# Уведомления о новых заявках в Telegram-чат отдела продаж.
# Если токен или chat id пустые — уведомления отключены (заявки создаются как
# обычно). Секреты держим только здесь, в репозиторий не коммитим.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
# Базовый URL CRM для ссылки на заявку в уведомлении (без хвостового /).
CRM_BASE_URL="http://localhost:5173"

# Хранение загруженных файлов (фото ЖК, документы).
# Каталог на диске; на VPS — постоянный том, который раздаёт nginx. Локально —
# относительный путь от backend/. В репозиторий каталог не коммитим.
FILES_DIR="uploads"
# Публичный префикс ссылок на файлы (как их раздаёт nginx).
FILES_PUBLIC_BASE="/files"
